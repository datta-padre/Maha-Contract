<%- include('../partials/header') %>
<%
    var pending = (typeof pendingUsers !== 'undefined' && Array.isArray(pendingUsers)) ? pendingUsers : [];

    function safe(val) {
        return (val === undefined || val === null || val === '') ? '—' : val;
    }
    function money(amount) {
        if (!amount && amount !== 0) return '—';
        return '₹' + Number(amount).toLocaleString('en-IN');
    }
    function payBadge(status) {
        var s = (status || 'pending').toLowerCase();
        if (s === 'paid') return { color: '#22c55e', label: 'Paid' };
        if (s === 'failed') return { color: '#ef4444', label: 'Failed' };
        return { color: '#eab308', label: 'Pending' };
    }
    function docUrl(file) {
        if (!file || !String(file).trim()) return '';
        return '/admin/view-doc?file=' + encodeURIComponent(String(file).trim());
    }
    function kycDocs(u) {
        return [
            { label: 'Photo', file: u.profile_picture },
            { label: 'Signature', file: u.digital_signature },
            { label: 'Qualification', file: u.qualifications },
            { label: 'License', file: u.licenses },
            { label: 'Aadhaar', file: u.adhar_card },
            { label: 'PAN', file: u.pan_card },
            { label: 'GST', file: u.gst_certificate },
            { label: 'Income cert', file: u.insurance_certificate },
            { label: 'NCL', file: u.non_crime_certificate },
            { label: 'Police NOC', file: u.police_ncertificate },
            { label: 'Portfolio', file: u.previous_work },
            { label: 'Stamp', file: u.legal_agreement }
        ].filter(function (d) { return d.file && String(d.file).trim(); });
    }
%>
<div class="background-animation"></div>
<div class="dashboard-layout">
    <aside class="sidebar">
        <div class="logo sidebar-logo"><i data-lucide="shield-check" class="logo-icon"></i><span style="color:#ef4444;">Admin</span>Desk</div>
        <nav class="sidebar-nav">
            <a href="/admin/verify-dashboard"><i data-lucide="layout-dashboard"></i> Overview</a>
            <a href="/admin/pending-users" class="active"><i data-lucide="clock"></i> Pending Queue</a>
            <a href="/admin/verified"><i data-lucide="database"></i> Verified Database</a>
            <a href="/" class="logout"><i data-lucide="log-out"></i> Logout</a>
        </nav>
    </aside>
    <main class="dashboard-content">
        <header class="dashboard-header">
            <div>
                <h2>Verification Processing Queue</h2>
                <p style="color: var(--text-muted); margin-top: 0.35rem;">Open and review uploaded KYC documents from the database.</p>
            </div>
        </header>

        <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert-banner alert-error" style="margin-bottom: 1.25rem;">
            <i data-lucide="alert-circle"></i>
            <div><strong>Error</strong><p><%= error %></p></div>
        </div>
        <% } %>

        <div style="margin-bottom: 1.5rem; position: relative;">
            <i data-lucide="search" style="position: absolute; left: 1rem; top: 1rem; color: var(--text-muted);"></i>
            <input type="text" id="searchInput" placeholder="Search by name, email, phone or KYC ID..."
                   style="width: 100%; padding: 1rem 1rem 1rem 3rem; border-radius: 12px; background: rgba(15,23,42,0.6); border: 1px solid var(--surface-border); color: white; font-size: 1rem;">
        </div>

        <% if (pending.length === 0) { %>
        <div class="empty-state">
            <i data-lucide="check-circle" style="width: 48px; height: 48px; margin-bottom: 1rem; color: #22c55e;"></i>
            <h3>Queue is Empty</h3>
            <p>No contractors are awaiting document validation.</p>
        </div>
        <% } else { %>
        <div class="pending-grid" style="display: grid; grid-template-columns: 1fr; gap: 1.5rem;">
            <% pending.forEach(function (u) {
                var pay = payBadge(u.payment_status);
                var docs = kycDocs(u);
                var searchKey = [u.kyc_id, u.full_name, u.email, u.phone].join(' ').toLowerCase();
            %>
            <div class="user-card" data-search="<%= searchKey %>"
                 style="background: rgba(15,23,42,0.6); border-radius: 12px; border: 1px solid var(--surface-border); overflow: hidden;">
                <div onclick="toggleDetails(<%= u.kyc_id %>)"
                     style="padding: 1.5rem; display: flex; justify-content: space-between; align-items: center; cursor: pointer; background: rgba(255,255,255,0.02)">
                    <div>
                        <h3 style="margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                            <%= safe(u.full_name) %>
                            <span style="font-size: 0.8rem; background: rgba(234, 179, 8, 0.1); color: #eab308; padding: 0.2rem 0.5rem; border-radius: 4px;">KYC #<%= u.kyc_id %></span>
                            <span style="font-size: 0.8rem; color: <%= pay.color %>;"><%= pay.label %></span>
                        </h3>
                        <p style="color: var(--text-muted); margin: 0;">
                            <i data-lucide="phone" style="width:14px; display:inline;"></i> <%= safe(u.phone) %>
                            &nbsp;·&nbsp;
                            <i data-lucide="mail" style="width:14px; display:inline;"></i> <%= safe(u.email) %>
                        </p>
                    </div>
                    <div><i data-lucide="chevron-down" id="icon-<%= u.kyc_id %>"></i></div>
                </div>

                <div id="details-<%= u.kyc_id %>" style="display: none; padding: 1.5rem; border-top: 1px solid var(--surface-border); background: var(--background);">
                    <h4 style="margin-bottom: 1rem;">Verification Documents (<%= docs.length %>)</h4>
                    <% if (docs.length === 0) { %>
                    <p style="color: var(--text-muted); margin-bottom: 1.5rem;">No documents found for this KYC record.</p>
                    <% } else { %>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
                        <% docs.forEach(function (doc) { %>
                        <a href="<%= docUrl(doc.file) %>" target="_blank" rel="noopener"
                           style="padding: 1rem; border: 1px solid var(--surface-border); border-radius: 8px; text-align: center; text-decoration: none; color: inherit; display:block;">
                            <i data-lucide="file-text" style="color:var(--accent); margin-bottom: 0.5rem;"></i>
                            <p style="font-size:0.85rem; margin:0;">View <%= doc.label %></p>
                        </a>
                        <% }) %>
                    </div>
                    <% } %>

                    <h4 style="margin-bottom: 1rem;">Payment &amp; Compliance</h4>
                    <div style="background: rgba(234, 179, 8, 0.1); border: 1px solid rgba(234, 179, 8, 0.2); padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;">
                        <p style="color: #eab308; font-weight: bold; margin-bottom: 0.5rem;"><%= safe(u.contractor_payment_status) %> · <%= pay.label %></p>
                        <p style="font-size: 0.9rem; color: var(--text-muted); margin:0;">
                            Amount: <%= money(u.payment_amount) %>
                            <% if (u.payment_transaction_id) { %> · Txn: <%= u.payment_transaction_id %><% } %>
                        </p>
                    </div>

                    <button type="button" onclick="approveKyc(<%= u.kyc_id %>)" class="btn-primary full-width"
                            style="padding: 1rem; font-size: 1.1rem; border-radius: 8px; background: #22c55e;">
                        <i data-lucide="check-circle" style="display:inline; margin-right:8px;"></i>
                        Approve &amp; Verify Contractor
                    </button>
                </div>
            </div>
            <% }) %>
        </div>
        <% } %>
    </main>
</div>

<script src="/js/app.js"></script>
<script>
    if (window.lucide) lucide.createIcons();

    var searchInput = document.getElementById('searchInput');
    if (searchInput) {
        searchInput.addEventListener('input', function (e) {
            var term = e.target.value.toLowerCase();
            document.querySelectorAll('.user-card').forEach(function (card) {
                var hay = (card.getAttribute('data-search') || '').toLowerCase();
                card.style.display = hay.indexOf(term) !== -1 ? 'block' : 'none';
            });
        });
    }

    function toggleDetails(id) {
        var el = document.getElementById('details-' + id);
        var icon = document.getElementById('icon-' + id);
        if (!el) return;
        if (el.style.display === 'none') {
            el.style.display = 'block';
            if (icon) icon.setAttribute('data-lucide', 'chevron-up');
        } else {
            el.style.display = 'none';
            if (icon) icon.setAttribute('data-lucide', 'chevron-down');
        }
        if (window.lucide) lucide.createIcons();
    }

    async function approveKyc(id) {
        if (!confirm('Approve KYC #' + id + ' after reviewing documents?')) return;
        try {
            var res = await fetch('/admin/approve-kyc/' + id, { method: 'POST' });
            var data = await res.json();
            if (!data.success) {
                alert(data.message || 'Could not approve KYC.');
                return;
            }
            window.location.reload();
        } catch (err) {
            console.error(err);
            alert('Could not approve KYC.');
        }
    }
</script>

