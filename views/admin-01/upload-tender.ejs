<%- include('../partials/header') %>
<div class="background-animation"></div>
    <div class="dashboard-layout">
        <aside class="sidebar">
            <div class="logo sidebar-logo"><i data-lucide="shield-check" class="logo-icon"></i><span style="color:#ef4444;">Admin</span>Desk</div>
            <nav class="sidebar-nav">
                <a href="/admin/verify-dashboard"><i data-lucide="layout-dashboard"></i> Overview</a>
                <a href="/admin/upload-tender" class="active"><i data-lucide="upload"></i> Upload Tender System</a>
                <a href="/admin/pending-users"><i data-lucide="clock"></i> Pending Queue</a>
                <a href="/admin/verified"><i data-lucide="database"></i> Verified Database</a>
                <a href="/" class="logout"><i data-lucide="log-out"></i> Logout</a>
            </nav>
        </aside>
        <main class="dashboard-content">
            <header class="dashboard-header">
                <div>
                    <h2>Admin System Upload</h2>
                    <p style="color: var(--text-muted); margin-top: 0.25rem;">Upload a tender safely on behalf of a Verified Owner.</p>
                </div>
            </header>
            <form class="form-section" onsubmit="event.preventDefault(); window.deployTender(this);">
                <h3><i data-lucide="upload-cloud"></i> Attach Secure Owner Uploads</h3>
                <div class="form-group mt-4" style="margin-bottom: 1rem;">
                    <label>Link to Owner ID & Name</label>
                    <input type="text" id="admin-owner" placeholder="e.g. #001124 (Rohan Desai)" style="width:100%; padding: 0.75rem; background: rgba(0,0,0,0.2); border: 1px solid var(--surface-border); border-radius: 8px; color: inherit; font-size:1rem; margin-bottom:1rem;" required>
                </div>
                <div class="form-group" style="margin-bottom: 1rem;">
                    <label>Tender Title</label>
                    <input type="text" id="admin-title" placeholder="e.g. 3BHK Eco-Friendly Villa" style="width:100%; padding: 0.75rem; background: rgba(0,0,0,0.2); border: 1px solid var(--surface-border); border-radius: 8px; color: inherit; font-size:1rem; margin-bottom:1rem;" required>
                </div>
                <div class="form-grid" style="grid-template-columns: 1fr 1fr; margin-bottom: 1rem;">
                    <div class="form-group">
                        <label>Target Taluka Location</label>
                        <input type="text" id="admin-taluka" placeholder="e.g. Haveli" style="width:100%; padding: 0.75rem; background: rgba(0,0,0,0.2); border: 1px solid var(--surface-border); border-radius: 8px; color: inherit; font-size:1rem;" required>
                    </div>
                    <div class="form-group">
                        <label>Approved Budget (₹)</label>
                        <input type="number" id="admin-budget" placeholder="e.g. 5000000" style="width:100%; padding: 0.75rem; background: rgba(0,0,0,0.2); border: 1px solid var(--surface-border); border-radius: 8px; color: inherit; font-size:1rem;" required>
                    </div>
                </div>
                <div class="form-group">
                    <label>CAD Plan Upload</label>
                    <input type="file" style="margin-bottom:1.5rem; display:block; color:white;">
                    <button type="submit" class="btn-primary">Deploy to Live Marketplace</button>
                </div>
            </form>
        </main>
    </div>
    <script src="/js/app.js"></script>
