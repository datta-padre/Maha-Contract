<%- include('../partials/header') %>
<div class="background-animation"></div>
    <div class="dashboard-layout">
        <aside class="sidebar">
            <div class="logo sidebar-logo"><i data-lucide="shield-check" class="logo-icon"></i><span style="color:#ef4444;">Admin</span>Desk</div>
            <nav class="sidebar-nav">
                <a href="#" onclick="switchTab('overview', event)"><i data-lucide="layout-dashboard"></i> Overview</a>
                <a href="#" onclick="switchTab('check', event)"><i data-lucide="search"></i> Check Reports</a>
                <a href="#" onclick="switchTab('live', event)"><i data-lucide="activity"></i> Live Bidding</a>
                <a href="#" onclick="switchTab('assigned', event)"><i data-lucide="check-circle"></i> Assigned Bidding</a>
                <a href="/" class="logout"><i data-lucide="log-out"></i> Logout</a>
            </nav>
        </aside>
        <main class="dashboard-content">
            <header class="dashboard-header">
                <div>
                    <h2>Tender Admin Desk</h2>
                    <p style="color:var(--text-muted); font-size:0.9rem;" id="headerSubtitle">Unified hub for verifying Budget Admin reports and managing platform bidding.</p>
                </div>
            </header>
            
            <!-- OVERVIEW TAB -->
            <div id="tab-overview" class="tab-content" style="display: block;">
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
                    <div style="background: rgba(15,23,42,0.6); padding: 1.5rem; border-radius: 12px; border: 1px solid var(--surface-border);">
                        <h4 style="color:var(--text-muted); font-weight:normal;">Pending Verification</h4>
                        <h2 style="font-size: 2rem; color: #38bdf8; margin: 0.5rem 0;" id="statCheck">0</h2>
                    </div>
                    <div style="background: rgba(15,23,42,0.6); padding: 1.5rem; border-radius: 12px; border: 1px solid var(--surface-border);">
                        <h4 style="color:var(--text-muted); font-weight:normal;">Live in Marketplace</h4>
                        <h2 style="font-size: 2rem; color: #a855f7; margin: 0.5rem 0;" id="statLive">0</h2>
                    </div>
                    <div style="background: rgba(15,23,42,0.6); padding: 1.5rem; border-radius: 12px; border: 1px solid var(--surface-border);">
                        <h4 style="color:var(--text-muted); font-weight:normal;">Contracts Assigned</h4>
                        <h2 style="font-size: 2rem; color: #22c55e; margin: 0.5rem 0;" id="statAssigned">0</h2>
                    </div>
                </div>
                <p style="color:var(--text-muted);">Navigate the sidebar to manage specific elements of the Tender pipeline.</p>
            </div>

            <!-- CHECK REPORTS TAB -->
            <div id="tab-check" class="tab-content" style="display: none;">
                <h3 style="margin-bottom: 1.5rem; color: #38bdf8; border-bottom: 1px solid var(--surface-border); padding-bottom: 0.5rem;">Verify Budget Reports & Publish</h3>
                <div id="tenderMatrixContainer"></div>
            </div>

            <!-- LIVE BIDDING TAB -->
            <div id="tab-live" class="tab-content" style="display: none;">
                <h3 style="margin-bottom: 1.5rem; color: #a855f7; border-bottom: 1px solid var(--surface-border); padding-bottom: 0.5rem;">Live Bidding Dashboard</h3>
                <div id="publishedTenderContainer"></div>
            </div>

            <!-- ASSIGNED BIDDING TAB -->
            <div id="tab-assigned" class="tab-content" style="display: none;">
                <h3 style="margin-bottom: 1.5rem; color: #22c55e; border-bottom: 1px solid var(--surface-border); padding-bottom: 0.5rem;">Assigned Bidding (Contracts Locked)</h3>
                <div id="assignedTenderContainer"></div>
            </div>

        </main>
    </div>
    <script src="/js/app.js"></script>
    <script>
        lucide.createIcons();

        function switchTab(tabId, eventArg) {
            document.querySelectorAll('.tab-content').forEach(el => el.style.display = 'none');
            document.getElementById('tab-' + tabId).style.display = 'block';
            
            const links = document.querySelectorAll('.sidebar-nav a');
            links.forEach(link => link.classList.remove('active'));
            if (eventArg && eventArg.currentTarget) {
                eventArg.currentTarget.classList.add('active');
            }
            
            const subtitle = document.getElementById('headerSubtitle');
            if(tabId === 'overview') subtitle.innerText = "Unified hub for verifying Budget Admin reports and managing platform bidding.";
            if(tabId === 'check') subtitle.innerText = "Verify Budget Admin reports and upload/push tenders to the Live System.";
            if(tabId === 'live') subtitle.innerText = "Monitor active bidding from contractors, sort quotes, and assign tenders.";
            if(tabId === 'assigned') subtitle.innerText = "View tenders that have been awarded and officially assigned to a contractor.";
        }

        function renderTenders() {
            const tenders = JSON.parse(localStorage.getItem('working_tenders')) || [];
            const container = document.getElementById('tenderMatrixContainer');
            const pubContainer = document.getElementById('publishedTenderContainer');
            const assignContainer = document.getElementById('assignedTenderContainer');
            
            container.innerHTML = '';
            pubContainer.innerHTML = '';
            assignContainer.innerHTML = '';

            const pending = tenders.filter(t => t.status === 'pending_tender_admin');
            const pub = tenders.filter(t => t.status === 'published');
            const assigned = tenders.filter(t => t.status === 'assigned');

            document.getElementById('statCheck').innerText = pending.length;
            document.getElementById('statLive').innerText = pub.length;
            document.getElementById('statAssigned').innerText = assigned.length;

            if(pending.length === 0) container.innerHTML = '<p style="text-align:center; color:var(--text-muted); padding:2rem; border:1px dashed var(--surface-border); border-radius:8px;">No reports waiting for verification.</p>';
            if(pub.length === 0) pubContainer.innerHTML = '<p style="text-align:center; color:var(--text-muted); padding:2rem; border:1px dashed var(--surface-border); border-radius:8px;">No live bidding tenders.</p>';
            if(assigned.length === 0) assignContainer.innerHTML = '<p style="text-align:center; color:var(--text-muted); padding:2rem; border:1px dashed var(--surface-border); border-radius:8px;">No assigned contracts yet.</p>';

            pending.forEach(t => {
                container.innerHTML += `
                    <div style="background: var(--background); border: 1px solid var(--surface-border); border-radius: 12px; padding: 1.5rem; margin-bottom: 1rem;">
                        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 1rem;">
                            <div>
                                <h4 style="font-size: 1.2rem; color: #fff;">${t.id}: ${t.title}</h4>
                                <p style="color:var(--text-muted); font-size:0.9rem;">Owner: ${t.owner} | Area: ${t.area}</p>
                            </div>
                            <span style="background: rgba(34, 197, 94, 0.1); color: #22c55e; padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.85rem; border: 1px solid #22c55e;">Ready to Verify & Release</span>
                        </div>

                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
                            <div style="padding: 1rem; border-radius: 8px; background: rgba(0,0,0,0.2); border: 1px solid var(--surface-border);">
                                <h5 style="color: var(--text-muted); margin-bottom: 0.25rem; font-size: 0.8rem;">Budget Admin Estimate</h5>
                                <strong style="font-size: 1.1rem; color: #fff;">₹${t.budget}</strong>
                            </div>
                            <div style="padding: 1rem; border-radius: 8px; background: rgba(0,0,0,0.2); border: 1px solid var(--surface-border);">
                                <h5 style="color: var(--text-muted); margin-bottom: 0.25rem; font-size: 0.8rem;">Target Completion</h5>
                                <strong style="font-size: 1.1rem; color: #fff;">${t.completion}</strong>
                            </div>
                        </div>

                        <h5 style="margin-bottom: 0.5rem;">Linked Verification Documents</h5>
                        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
                            <button class="btn-secondary" style="font-size: 0.85rem; padding: 0.5rem 1rem;"><i data-lucide="file-text" style="width:16px;"></i> CAD Docs</button>
                            <button class="btn-secondary" style="font-size: 0.85rem; padding: 0.5rem 1rem;"><i data-lucide="calculator" style="width:16px;"></i> Verify Budget PDF Report</button>
                            <button class="btn-primary" style="font-size: 0.85rem; padding: 0.5rem 1rem; background: #38bdf8; border-color: #38bdf8;" onclick="publishTender('${t.id}')"><i data-lucide="upload" style="width:16px;"></i> Verify Report & Publish to System</button>
                        </div>
                    </div>
                `;
            });

            pub.forEach(t => {
                pubContainer.innerHTML += `
                    <div style="background: rgba(168,85,247,0.05); border: 1px solid rgba(168,85,247,0.2); border-radius: 12px; padding: 1.5rem; margin-bottom: 1rem;">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
                            <div>
                                <h4 style="font-size: 1.2rem; color: #fff;">${t.id}: ${t.title} <i data-lucide="activity" style="color:#a855f7; width:18px;"></i></h4>
                                <p style="color:var(--text-muted); font-size:0.9rem;">Estimated Cost: ₹${t.budget}</p>
                            </div>
                            <span style="background: #a855f7; color: #fff; padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.8rem; font-weight:bold;">LIVE BIDDING</span>
                        </div>
                        <h5 style="margin-bottom: 0.5rem;">Received Contractor Bids (Sorted)</h5>
                        <table style="width: 100%; border-collapse: collapse; text-align: left; background: rgba(0,0,0,0.2); border-radius: 8px; overflow: hidden;">
                            <tr style="background: rgba(255,255,255,0.05); color: var(--text-muted);">
                                <th style="padding: 1rem;">Contractor Auth Name</th>
                                <th>Bid Amount</th>
                                <th>Timeline</th>
                                <th>Action</th>
                            </tr>
                            <tr style="border-bottom: 1px solid var(--surface-border);">
                                <td style="padding: 1rem;">Ramesh Builders <i data-lucide="shield-check" style="color:#22c55e; width:16px;"></i></td>
                                <td><strong style="color:#fff;">₹23,50,000</strong></td>
                                <td>9 Months</td>
                                <td><button class="btn-primary" style="padding: 0.4rem 0.8rem; font-size: 0.8rem; background: #22c55e; border-color: #22c55e;" onclick="assignTender('${t.id}', 'Ramesh Builders')">Assign Tender</button></td>
                            </tr>
                            <tr style="border-bottom: 1px solid var(--surface-border);">
                                <td style="padding: 1rem;">City Scape Dev <i data-lucide="shield-check" style="color:#22c55e; width:16px;"></i></td>
                                <td><strong style="color:#fff;">₹25,00,000</strong></td>
                                <td>7 Months</td>
                                <td><button class="btn-primary" style="padding: 0.4rem 0.8rem; font-size: 0.8rem; background: transparent; border: 1px solid var(--surface-border);" onclick="assignTender('${t.id}', 'City Scape Dev')">Assign Tender</button></td>
                            </tr>
                        </table>
                    </div>
                `;
            });

            assigned.forEach(t => {
                assignContainer.innerHTML += `
                    <div style="background: rgba(34,197,94,0.05); border: 1px solid rgba(34,197,94,0.2); border-radius: 12px; padding: 1.5rem; margin-bottom: 1rem; display:flex; justify-content:space-between; align-items:center;">
                        <div>
                            <h4 style="font-size: 1.2rem; color: #fff;">${t.id}: ${t.title} <i data-lucide="check-circle" style="color:#22c55e; width:18px;"></i></h4>
                            <p style="color:var(--text-muted); font-size:0.9rem;">Assigned Contractor: <strong style="color:#fff;">${t.assignedContractor || 'Unknown'}</strong></p>
                        </div>
                        <span style="background: #22c55e; color: #fff; padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.8rem; font-weight:bold;">ASSIGNED CONTRACT</span>
                    </div>
                `;
            });

            lucide.createIcons();
        }

        function publishTender(id) {
            if(confirm("Report Verified. Deploying to Live Bidding System?")) {
                let tenders = JSON.parse(localStorage.getItem('working_tenders')) || [];
                let tenderInfo = tenders.find(t => t.id === id);
                if(tenderInfo) {
                    tenderInfo.status = 'published';
                    localStorage.setItem('working_tenders', JSON.stringify(tenders));
                    alert("Tender Uploaded to Live Bidding Dashboard!");
                    renderTenders();
                    document.querySelector('.sidebar-nav a:nth-child(3)').click();
                }
            }
        }

        function assignTender(id, contractorName) {
            if(confirm("Are you sure you want to officially assign this tender to " + contractorName + "?")) {
                let tenders = JSON.parse(localStorage.getItem('working_tenders')) || [];
                let tenderInfo = tenders.find(t => t.id === id);
                if(tenderInfo) {
                    tenderInfo.status = 'assigned';
                    tenderInfo.assignedContractor = contractorName;
                    localStorage.setItem('working_tenders', JSON.stringify(tenders));
                    alert("Contract successfully assigned to " + contractorName + "!");
                    renderTenders();
                    document.querySelector('.sidebar-nav a:nth-child(4)').click();
                }
            }
        }

        renderTenders();
    </script>
<%- include('../partials/footer') %>
