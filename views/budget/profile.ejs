<%- include('../partials/header') %>
<div class="background-animation"></div>
<div class="dashboard-layout bdg-desk">
    <%- include('./_sidebar') %>

    <main class="dashboard-content">
        <header class="dashboard-header bdg-header">
            <div>
                <p class="bdg-kicker">Budget Admin</p>
                <h2>Budget Admin Profile</h2>
                <p class="bdg-subtitle">Your desk account for tender budget estimation.</p>
            </div>
        </header>

        <section class="bdg-profile-card">
            <div class="bdg-profile-head">
                <div class="bdg-profile-avatar">
                    <i data-lucide="calculator"></i>
                </div>
                <div>
                    <strong>Budget Admin</strong>
                    <p>Estimator desk role</p>
                </div>
            </div>
            <p class="bdg-profile-copy">
                Use the sidebar to review pending tenders, submit cost estimates, upload PDF reports, and track house-owner platform payments.
            </p>
            <div class="bdg-empty-actions" style="justify-content:flex-start;margin-top:1.25rem;">
                <a href="/budget-admin/pending" class="btn-primary">Open pending queue</a>
                <a href="/budget-admin" class="btn-secondary">Overview</a>
            </div>
        </section>
    </main>
</div>

<script src="/js/app.js"></script>
<script>if (window.lucide) lucide.createIcons();</script>
