<%- include('../partials/header') %>
<%
    var kyc = (typeof contractor_kyc !== 'undefined' && contractor_kyc) ? contractor_kyc : null;
    var kycDocs = (typeof docs !== 'undefined' && docs) ? docs : {};
    var profileUser = (typeof user !== 'undefined' && user) ? user : {};
    function docUrl(name) {
        if (!name) return '';
        var first = String(name).split(',')[0].trim();
        return first ? '/contractor/view-doc?file=' + encodeURIComponent(first) : '';
    }
    var docItems = [
        { key: 'profilePhoto', label: 'Profile Photo', icon: 'image' },
        { key: 'digitalSignature', label: 'Digital Signature', icon: 'pen-tool' },
        { key: 'qualificationDoc', label: 'Degree / Qualification', icon: 'graduation-cap' },
        { key: 'licenseDoc', label: 'Govt Construction License', icon: 'file-check' },
        { key: 'aadhaarDoc', label: 'Aadhaar Card', icon: 'credit-card' },
        { key: 'panDoc', label: 'PAN Card', icon: 'credit-card' },
        { key: 'gstDoc', label: 'GST Certificate', icon: 'file-spreadsheet' },
        { key: 'incomeCert', label: 'Income Certificate', icon: 'landmark' },
        { key: 'nclCert', label: 'Non-Creamy Layer Cert', icon: 'badge-percent' },
        { key: 'policeNoc', label: 'Police NOC / Background', icon: 'siren' },
        { key: 'portfolioImages', label: 'Previous Work Photos', icon: 'image-plus' },
        { key: 'stampAgreement', label: 'Stamp Paper Legal Agreement', icon: 'file-signature' }
    ];
    var uploadedDocs = docItems.filter(function (item) {
        return kycDocs[item.key] && String(kycDocs[item.key]).trim();
    });
%>
<div class="background-animation"></div>
    <div class="dashboard-layout">
        <aside class="sidebar">
            <div class="logo sidebar-logo"><i data-lucide="hard-hat" class="logo-icon"></i><span class="notranslate"><span>Build</span>Tender</span></div>
            <nav class="sidebar-nav">
                <a href="/contractor/dashboard"><i data-lucide="shield-check"></i> KYC & Profile</a>
                <a href="/contractor/marketplace"><i data-lucide="shopping-cart"></i> Tender Marketplace</a>
                <a href="/contractor/materials"><i data-lucide="shopping-bag"></i> Buy Material</a>
                <a href="/contractor/bids"><i data-lucide="briefcase"></i> My Bids</a>
                <a href="/contractor/profile" class="active"><i data-lucide="user"></i> My Profile</a>
                <a href="/logout" class="logout"><i data-lucide="log-out"></i> Logout</a>
            </nav>
        </aside>

        <main class="dashboard-content">
            <header class="dashboard-header">
                <div>
                    <h2>Account Settings</h2>
                    <p style="color: var(--text-muted);">Manage your personal Contractor profile and uploaded KYC documents.</p>
                </div>
            </header>

            <div class="profile-header">
                <div class="profile-avatar">
                    <% if (kycDocs.profilePhoto) { %>
                        <img src="<%= docUrl(kycDocs.profilePhoto) %>" alt="Profile" style="width:100%;height:100%;object-fit:cover;border-radius:inherit;">
                    <% } else { %>
                        <i data-lucide="user"></i>
                    <% } %>
                </div>
                <div>
                    <h3 style="font-size: 1.5rem; margin-bottom: 0.25rem;" id="ui-profile-name"><%= (kyc && kyc.full_name) || profileUser.username || 'Contractor Account' %></h3>
                    <p style="color: var(--text-muted); margin-bottom: 0.5rem;" id="ui-profile-email"><%= (kyc && kyc.email) || profileUser.email || '' %></p>
                    <% if (kyc && kyc.contractor_kyc_status === 'approved') { %>
                    <span class="status-badge" style="background: rgba(34, 197, 94, 0.1); color: #22c55e; border: 1px solid rgba(34, 197, 94, 0.2);"><i data-lucide="shield-check" style="width:14px; display:inline; vertical-align:middle;"></i> Verified Contractor</span>
                    <% } else if (kyc) { %>
                    <span class="status-badge" style="background: rgba(234, 179, 8, 0.1); color: #eab308; border: 1px solid rgba(234, 179, 8, 0.2);"><i data-lucide="clock" style="width:14px; display:inline; vertical-align:middle;"></i> KYC <%= kyc.contractor_kyc_status || 'pending' %></span>
                    <% } else { %>
                    <span class="status-badge" style="background: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2);"><i data-lucide="alert-circle" style="width:14px; display:inline; vertical-align:middle;"></i> KYC not submitted</span>
                    <% } %>
                </div>
            </div>

            <form class="tender-form" style="background: rgba(15, 23, 42, 0.4); padding: 2rem; border-radius: 12px; border: 1px solid var(--surface-border);" onsubmit="updateProfile(this, event)">
                <h3 style="margin-bottom: 1.5rem; font-family: 'Outfit'; color: var(--accent);">Personal Information</h3>
                <div class="form-grid">
                    <div class="form-group">
                        <label>Full Name</label>
                        <input type="text" style="width:100%; padding: 0.75rem; background: rgba(0,0,0,0.2); border: 1px solid var(--surface-border); border-radius: 8px; color: inherit; font-size:1rem;" value="<%= (kyc && kyc.full_name) || profileUser.username || '' %>" required>
                    </div>
                    <div class="form-group">
                        <label>Email Address</label>
                        <input type="email" style="width:100%; padding: 0.75rem; background: rgba(0,0,0,0.2); border: 1px solid var(--surface-border); border-radius: 8px; color: inherit; font-size:1rem;" id="ui-input-email" value="<%= (kyc && kyc.email) || profileUser.email || '' %>" required>
                    </div>
                </div>
                <div class="form-grid">
                    <div class="form-group">
                        <label>Phone Number</label>
                        <input type="tel" style="width:100%; padding: 0.75rem; background: rgba(0,0,0,0.2); border: 1px solid var(--surface-border); border-radius: 8px; color: inherit; font-size:1rem;" id="ui-input-phone" value="<%= (kyc && kyc.phone) || profileUser.mobile || '' %>" required>
                    </div>
                    <div class="form-group">
                        <label>Change Password</label>
                        <input type="password" style="width:100%; padding: 0.75rem; background: rgba(0,0,0,0.2); border: 1px solid var(--surface-border); border-radius: 8px; color: inherit; font-size:1rem;" placeholder="Leave blank to keep current">
                    </div>
                </div>
                <h3 style="margin: 2.5rem 0 1.5rem; font-family: 'Outfit'; color: var(--accent);">Location Details</h3>
                <div class="form-grid" style="grid-template-columns: 1fr; margin-bottom: 1.5rem;">
                    <div class="form-group">
                        <label>Street Address</label>
                        <input type="text" style="width:100%; padding: 0.75rem; background: rgba(0,0,0,0.2); border: 1px solid var(--surface-border); border-radius: 8px; color: inherit; font-size:1rem;" value="<%= (kyc && kyc.location_link) || profileUser.address || '' %>" placeholder="Flat, House no., Building, Company, Apartment">
                    </div>
                </div>
                <div class="form-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
                    <div class="form-group">
                        <label>Taluka (Tal)</label>
                        <input type="text" style="width:100%; padding: 0.75rem; background: rgba(0,0,0,0.2); border: 1px solid var(--surface-border); border-radius: 8px; color: inherit; font-size:1rem;" value="<%= profileUser.taluka || '' %>" placeholder="e.g. Haveli">
                    </div>
                    <div class="form-group">
                        <label>District (Dist)</label>
                        <input type="text" style="width:100%; padding: 0.75rem; background: rgba(0,0,0,0.2); border: 1px solid var(--surface-border); border-radius: 8px; color: inherit; font-size:1rem;" value="<%= profileUser.district || '' %>" placeholder="e.g. Pune">
                    </div>
                    <div class="form-group">
                        <label>State</label>
                        <select style="width:100%; padding: 0.75rem; background: rgba(0,0,0,0.2); border: 1px solid var(--surface-border); border-radius: 8px; color: inherit; font-size:1rem;">
                            <option value="" <%= !profileUser.state ? 'selected' : '' %>>Select State</option>
                            <option value="Maharashtra" <%= profileUser.state === 'Maharashtra' ? 'selected' : '' %>>Maharashtra</option>
                            <option value="Gujarat" <%= profileUser.state === 'Gujarat' ? 'selected' : '' %>>Gujarat</option>
                            <option value="Karnataka" <%= profileUser.state === 'Karnataka' ? 'selected' : '' %>>Karnataka</option>
                        </select>
                    </div>
                </div>
                <button type="submit" class="btn-primary" style="margin-top: 1rem;"><i data-lucide="save" style="display:inline; width:18px; vertical-align:middle; margin-right:5px;"></i> Save Changes</button>
            </form>

            <h3 style="margin: 2.5rem 0 1.5rem; font-family: 'Outfit'; color: var(--accent);">Uploaded Documents (View Only)</h3>
            <% if (uploadedDocs.length === 0) { %>
                <div class="doc-list-empty">
                    No documents uploaded yet. Complete KYC from the <a href="/contractor/dashboard" style="color: var(--accent);">KYC Overview</a> page.
                </div>
            <% } else { %>
                <div class="doc-list">
                    <% uploadedDocs.forEach(function (item) { %>
                    <div class="doc-list-item">
                        <div class="doc-list-item-meta">
                            <i data-lucide="<%= item.icon %>"></i>
                            <div>
                                <h4><%= item.label %></h4>
                                <p title="<%= kycDocs[item.key] %>"><%= kycDocs[item.key] %></p>
                            </div>
                        </div>
                        <a class="btn-secondary btn-small doc-view-link" href="<%= docUrl(kycDocs[item.key]) %>" target="_blank" rel="noopener" onclick="event.preventDefault(); event.stopPropagation(); window.open(this.href, '_blank'); return false;">
                            <i data-lucide="eye"></i> View
                        </a>
                    </div>
                    <% }) %>
                </div>
            <% } %>

            <h3 style="margin: 2.5rem 0 1.5rem; font-family: 'Outfit'; color: var(--accent);">Support & Legal</h3>
            <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 3rem;">
                <a href="#" style="background: var(--surface); padding: 1.5rem; border-radius: 8px; border: 1px solid var(--surface-border); display: flex; justify-content: space-between; align-items: center; color: inherit; text-decoration: none; transition: 0.2s;" onmouseover="this.style.borderColor='var(--primary)'" onmouseout="this.style.borderColor='var(--surface-border)'">
                    <div style="display: flex; align-items: center; gap: 1rem;">
                        <i data-lucide="shield" style="color: var(--primary);"></i>
                        <span style="font-weight: 600;">Privacy Policy & Terms</span>
                    </div>
                    <i data-lucide="chevron-right" style="color: var(--text-muted);"></i>
                </a>
                <a href="#" style="background: var(--surface); padding: 1.5rem; border-radius: 8px; border: 1px solid var(--surface-border); display: flex; justify-content: space-between; align-items: center; color: inherit; text-decoration: none; transition: 0.2s;" onmouseover="this.style.borderColor='var(--primary)'" onmouseout="this.style.borderColor='var(--surface-border)'">
                    <div style="display: flex; align-items: center; gap: 1rem;">
                        <i data-lucide="headphones" style="color: var(--primary);"></i>
                        <span style="font-weight: 600;">Customer Care Helpdesk</span>
                    </div>
                    <i data-lucide="chevron-right" style="color: var(--text-muted);"></i>
                </a>
            </div>
        </main>
    </div>
    <script src="/js/app.js"></script>
    <script>if (window.lucide) lucide.createIcons();</script>
