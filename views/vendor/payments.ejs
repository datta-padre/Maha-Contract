<%- include('../partials/header') %>
<div class="background-animation"></div>
    <div class="dashboard-layout vendor-desk">
        <%- include('_sidebar', { active: 'payments' }) %>
        <main class="dashboard-content">
            <header class="dashboard-header">
                <div>
                    <h2>Payments</h2>
                    <p class="vendor-page-description">Review advance payments and cash-on-delivery collections.</p>
                </div>
            </header>
            <div class="empty-state vendor-empty-state">
                <i data-lucide="wallet" aria-hidden="true"></i>
                <h3>No transactions yet</h3>
                <p>Advance payments and cash-on-delivery collections will appear here when an order is placed.</p>
                <a class="vendor-empty-action" href="/vendor/orders">
                    <i data-lucide="truck" aria-hidden="true"></i> View live orders
                </a>
            </div>
        </main>
    </div>
    <script src="/js/app.js"></script>
    <script>lucide.createIcons();</script>
