<%- include('../partials/header') %>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<link href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" rel="stylesheet">
<link href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css" rel="stylesheet">

<style>
  /* Bridge Bootstrap with BuildTender theme */
  .inventory-page {
    color: var(--text-main);
  }
  .inventory-page .page-subtitle {
    color: var(--text-muted);
  }
  .inventory-page .app-card {
    background: rgba(15, 23, 42, 0.55);
    border: 1px solid var(--surface-border);
    border-radius: 12px;
    color: var(--text-main);
  }
  .inventory-page .app-card .card-header {
    background: transparent;
    border-bottom: 1px solid var(--surface-border);
    padding: 1.25rem 1.5rem;
  }
  .inventory-page .app-card .card-body {
    padding: 1.5rem;
  }
  .inventory-page .app-card h5,
  .inventory-page .modal-title {
    font-family: 'Outfit', sans-serif;
    color: var(--accent);
    margin: 0;
  }
  .inventory-page .stat-mini {
    background: rgba(15, 23, 42, 0.45);
    border: 1px solid var(--surface-border);
    border-radius: 12px;
    padding: 1.25rem;
  }
  .inventory-page .stat-mini h3 {
    font-family: 'Outfit', sans-serif;
    font-size: 1.75rem;
    margin: 0.25rem 0 0;
    color: var(--text-main);
  }
  .inventory-page .stat-mini p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .inventory-page .btn-app-primary {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    border: none;
    color: #fff !important;
    font-weight: 600;
    border-radius: 8px;
    padding: 0.7rem 1.25rem;
    box-shadow: 0 4px 14px rgba(255, 90, 95, 0.3);
  }
  .inventory-page .btn-app-primary:hover {
    filter: brightness(1.05);
    color: #fff !important;
  }
  .inventory-page .btn-app-secondary {
    background: transparent;
    border: 1px solid var(--surface-border);
    color: var(--text-main) !important;
    border-radius: 8px;
  }
  .inventory-page .table {
    --bs-table-bg: transparent;
    --bs-table-color: var(--text-main);
    --bs-table-border-color: var(--surface-border);
    --bs-table-striped-bg: rgba(255,255,255,0.03);
    --bs-table-hover-bg: rgba(56, 189, 248, 0.08);
    color: var(--text-main) !important;
  }
  .inventory-page .table thead th {
    color: var(--text-muted) !important;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    border-bottom: 1px solid var(--surface-border) !important;
  }
  .inventory-page .table tbody td {
    color: var(--text-main) !important;
    vertical-align: middle;
    border-color: var(--surface-border);
  }
  .inventory-page .badge-category {
    background: rgba(56, 189, 248, 0.12);
    color: var(--accent);
    border: 1px solid rgba(56, 189, 248, 0.3);
    font-weight: 600;
  }
  .inventory-page .badge-stock-ok {
    background: rgba(34, 197, 94, 0.12);
    color: #4ade80;
    border: 1px solid rgba(34, 197, 94, 0.3);
  }
  .inventory-page .badge-stock-low {
    background: rgba(245, 158, 11, 0.12);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }
  .inventory-page .badge-count {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-main);
    border: 1px solid var(--surface-border);
  }
  .inventory-page .form-label {
    color: var(--text-muted);
    font-weight: 600;
    font-size: 0.9rem;
  }
  .inventory-page .form-control,
  .inventory-page .form-select,
  .inventory-page .modal-content {
    background: rgba(15, 23, 42, 0.9) !important;
    border: 1px solid var(--surface-border) !important;
    color: var(--text-main) !important;
    border-radius: 8px;
  }
  .inventory-page .form-control:focus,
  .inventory-page .form-select:focus {
    border-color: var(--accent) !important;
    box-shadow: 0 0 0 0.2rem rgba(56, 189, 248, 0.2);
  }
  .inventory-page .form-control::placeholder {
    color: #64748b !important;
  }
  .inventory-page .modal-header,
  .inventory-page .modal-footer {
    border-color: var(--surface-border) !important;
  }
  .inventory-page .modal-body,
  .inventory-page .modal-body dt,
  .inventory-page .modal-body dd {
    color: var(--text-main) !important;
  }
  .inventory-page .section-label {
    font-family: 'Outfit', sans-serif;
    color: var(--accent);
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }
  .inventory-page .dataTables_info,
  .inventory-page .dataTables_length label,
  .inventory-page .dataTables_filter label {
    color: var(--text-muted) !important;
  }
  .inventory-page .dataTables_filter input,
  .inventory-page .dataTables_length select {
    background: rgba(15, 23, 42, 0.7) !important;
    border: 1px solid var(--surface-border) !important;
    color: var(--text-main) !important;
    border-radius: 8px;
  }
  .inventory-page .dt-buttons .btn {
    margin: 0 0.35rem 0.35rem 0;
    background: rgba(15, 23, 42, 0.7) !important;
    border: 1px solid var(--surface-border) !important;
    color: var(--text-main) !important;
    border-radius: 8px;
  }
  .inventory-page .dt-buttons .buttons-excel { border-color: rgba(34,197,94,0.5) !important; color: #86efac !important; }
  .inventory-page .dt-buttons .buttons-pdf { border-color: rgba(239,68,68,0.5) !important; color: #fca5a5 !important; }
  .inventory-page .dt-buttons .buttons-print { border-color: rgba(56,189,248,0.5) !important; color: #7dd3fc !important; }
  .inventory-page .page-link {
    background: rgba(15, 23, 42, 0.7) !important;
    border-color: var(--surface-border) !important;
    color: var(--text-main) !important;
  }
  .inventory-page .page-item.active .page-link {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark)) !important;
    border-color: var(--primary) !important;
    color: #fff !important;
  }
  .inventory-page .page-item.disabled .page-link {
    color: #64748b !important;
  }
  .inventory-page .action-btns .btn {
    width: 34px;
    height: 34px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: transparent !important;
  }
  .inventory-page .btn-view { border: 1px solid rgba(56,189,248,0.5) !important; color: #7dd3fc !important; }
  .inventory-page .btn-edit { border: 1px solid rgba(250,204,21,0.5) !important; color: #fde047 !important; }
  .inventory-page .btn-delete { border: 1px solid rgba(248,113,113,0.5) !important; color: #fca5a5 !important; }
  .inventory-page .btn-close { filter: invert(1) grayscale(100%) brightness(200%); }
  .inventory-page .alert {
    border-radius: 10px;
  }

  /* Exact login-modal look (no Bootstrap modal conflict) */
  .bt-modal {
    display: none;
    position: fixed;
    z-index: 2000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(5px);
    align-items: center;
    justify-content: center;
  }
  .bt-modal-content {
    background: var(--background);
    border: 1px solid var(--surface-border);
    border-radius: 20px;
    padding: 2.5rem;
    width: 90%;
    max-width: 500px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    position: relative;
    animation: scaleIn 0.3s ease-out;
  }
  .bt-close {
    position: absolute;
    right: 1.5rem;
    top: 1.5rem;
    font-size: 1.5rem;
    font-weight: bold;
    cursor: pointer;
    color: var(--text-muted);
  }
  .bt-close:hover { color: var(--text-main); }
  .bt-modal h2 {
    margin-bottom: 0.5rem;
    color: #fff;
    font-family: 'Outfit', sans-serif;
  }
  .bt-modal p {
    color: var(--text-muted);
    margin-bottom: 2rem;
  }
  .bt-modal .form-group { margin-bottom: 1.5rem; }
  .bt-modal .form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: #fff;
  }
  .bt-modal .form-group input,
  .bt-modal .form-group select {
    width: 100%;
    padding: 0.75rem 1rem;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid var(--surface-border);
    border-radius: 8px;
    color: white;
    font-family: inherit;
  }
  .bt-modal .form-group input:focus,
  .bt-modal .form-group select:focus {
    outline: none;
    border-color: var(--accent);
  }
  .bt-modal .form-group select option {
    background: #0f172a;
    color: #fff;
  }
  .bt-modal .btn-primary.full-width {
    width: 100%;
    margin-top: 0.25rem;
  }
  .bt-modal .view-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--surface-border);
  }
  .bt-modal .view-row:last-of-type {
    border-bottom: none;
    margin-bottom: 0.75rem;
  }
  .bt-modal .view-label { color: var(--text-muted); font-size: 0.9rem; }
  .bt-modal .view-value { color: #fff; font-weight: 600; text-align: right; }
  .bt-modal .delete-name {
    font-weight: 700;
    color: #fff;
    margin: -1rem 0 0.5rem;
  }
  #inventoryLoading {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.75);
    z-index: 2000;
    display: none;
    align-items: center;
    justify-content: center;
  }
  #inventoryLoading.show { display: flex; }
  @media (max-width: 768px) {
    .inventory-page .dashboard-header {
      flex-direction: column;
      align-items: flex-start !important;
      gap: 1rem;
    }
  }
</style>

<div class="background-animation"></div>
<div class="dashboard-layout inventory-page">
  <aside class="sidebar">
    <div class="logo sidebar-logo"><i data-lucide="building-2" class="logo-icon"></i><span class="notranslate"><span>Build</span>Tender</span></div>
    <nav class="sidebar-nav">
      <a href="/vendor/dashboard"><i data-lucide="layout-dashboard"></i> Overview</a>
      <a href="/vendor/inventory" class="active"><i data-lucide="list"></i> My Inventory</a>
      <a href="/vendor/orders"><i data-lucide="truck"></i> Live Orders</a>
      <a href="/vendor/payments"><i data-lucide="wallet"></i> Payments</a>
      <a href="/vendor/profile"><i data-lucide="user"></i> Store Profile</a>
      <a href="/logout" class="logout"><i data-lucide="log-out"></i> Logout</a>
    </nav>
  </aside>

  <main class="dashboard-content">
    <header class="dashboard-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
      <div>
        <h2>My Inventory</h2>
        <p class="page-subtitle mb-0">Manage your materials and stock levels.</p>
      </div>
      <button type="button" class="btn btn-app-primary" onclick="openBtModal('addMaterialModal')">
        <i class="bi bi-plus-lg me-1"></i> Add New Material
      </button>
    </header>

    <div class="row g-3 mb-4">
      <div class="col-md-4">
        <div class="stat-mini">
          <i data-lucide="package" style="color: var(--primary); width:28px; height:28px;"></i>
          <h3><%= totalItems %></h3>
          <p>Listed Materials</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="stat-mini">
          <i data-lucide="boxes" style="color: var(--accent); width:28px; height:28px;"></i>
          <h3><%= Number(totalStock).toLocaleString('en-IN') %></h3>
          <p>Total Stock Units</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="stat-mini">
          <i data-lucide="indian-rupee" style="color:#22c55e; width:28px; height:28px;"></i>
          <h3>₹<%= Number(inventoryValue).toLocaleString('en-IN') %></h3>
          <p>Inventory Value</p>
        </div>
      </div>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i> <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i> <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="card app-card">
      <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
          <h5><i class="bi bi-box-seam me-2"></i>Materials List</h5>
          <small class="page-subtitle">Search, sort, export, and manage stock</small>
        </div>
        <span class="badge badge-count rounded-pill px-3 py-2"><%= totalItems %> item(s)</span>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table id="inventoryTable" class="table table-striped table-hover align-middle w-100">
            <thead>
              <tr>
                <th>#</th>
                <th>Material Name</th>
                <th>Category</th>
                <th>Stock</th>
                <th>Status</th>
                <th>Price / Unit</th>
                <th class="text-center">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (materials && materials.length > 0) { %>
                <% materials.forEach(function(material, index) { %>
                  <% var stock = Number(material.matQuantity || 0); %>
                  <tr
                    data-id="<%= material.mat_id %>"
                    data-name="<%= material.matName %>"
                    data-category="<%= material.matCategory %>"
                    data-quantity="<%= material.matQuantity %>"
                    data-price="<%= material.matPrice %>"
                  >
                    <td><%= index + 1 %></td>
                    <td class="fw-semibold"><%= material.matName %></td>
                    <td><span class="badge rounded-pill badge-category"><%= material.matCategory %></span></td>
                    <td><%= material.matQuantity %></td>
                    <td>
                      <% if (stock > 50) { %>
                        <span class="badge rounded-pill badge-stock-ok">In Stock</span>
                      <% } else { %>
                        <span class="badge rounded-pill badge-stock-low">Low Stock</span>
                      <% } %>
                    </td>
                    <td>₹<%= material.matPrice %></td>
                    <td class="text-center action-btns">
                      <button type="button" class="btn btn-sm btn-view" data-bs-toggle="tooltip" title="View">
                        <i class="bi bi-eye"></i>
                      </button>
                      <button type="button" class="btn btn-sm btn-edit" data-bs-toggle="tooltip" title="Edit">
                        <i class="bi bi-pencil-square"></i>
                      </button>
                      <button type="button" class="btn btn-sm btn-delete" data-bs-toggle="tooltip" title="Delete">
                        <i class="bi bi-trash"></i>
                      </button>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>

<div id="inventoryLoading">
  <div class="text-center text-white">
    <div class="spinner-border mb-2" style="color: var(--accent);" role="status"></div>
    <div>Please wait...</div>
  </div>
</div>

<!-- App-native modals (same UI as Welcome Back login) -->
<div id="addMaterialModal" class="bt-modal">
  <div class="bt-modal-content">
    <span class="bt-close" onclick="closeBtModal('addMaterialModal')">&times;</span>
    <h2>Add Material</h2>
    <p>Publish a new item to your inventory.</p>
    <form id="addMaterialForm" action="/vendor/add-material" method="post" enctype="multipart/form-data">
      <div class="form-group">
        <label>Material Name</label>
        <input type="text" name="matName" placeholder="e.g. Portland Cement (50kg)" required>
      </div>
      <div class="form-group">
        <label>Category</label>
        <select name="matCategory" required>
          <option value="">Select category</option>
          <option value="Cement & Concrete">Cement & Concrete</option>
          <option value="Steel & Metal">Steel & Metal</option>
          <option value="Bricks & Blocks">Bricks & Blocks</option>
          <option value="Wood & Timber">Wood & Timber</option>
          <option value="Plumbing">Plumbing</option>
          <option value="Electrical">Electrical</option>
          <option value="Other">Other</option>
        </select>
      </div>
      <div class="form-group">
        <label>Stock Quantity</label>
        <input type="number" name="matQuantity" min="1" placeholder="e.g. 500" required>
      </div>
      <div class="form-group">
        <label>Price / Unit (₹)</label>
        <input type="number" name="matPrice" min="1" placeholder="e.g. 350" required>
      </div>

      <div class="form-group">
        <label>Image</label>
        <input type="file" name="matImage" accept="image/*">
      </div>
      <button type="submit" class="btn-primary full-width">Save Material</button>
    </form>
  </div>
</div>

<div id="viewMaterialModal" class="bt-modal">
  <div class="bt-modal-content">
    <span class="bt-close" onclick="closeBtModal('viewMaterialModal')">&times;</span>
    <h2>View Material</h2>
    <p>Material details from your inventory.</p>
    <div class="view-row"><span class="view-label">ID</span><span class="view-value" id="viewId">-</span></div>
    <div class="view-row"><span class="view-label">Name</span><span class="view-value" id="viewName">-</span></div>
    <div class="view-row"><span class="view-label">Category</span><span class="view-value" id="viewCategory">-</span></div>
    <div class="view-row"><span class="view-label">Stock</span><span class="view-value" id="viewQuantity">-</span></div>
    <div class="view-row"><span class="view-label">Status</span><span class="view-value" id="viewStatus">-</span></div>
    <div class="view-row"><span class="view-label">Price</span><span class="view-value" id="viewPrice">-</span></div>
    <button type="button" class="btn-primary full-width" onclick="closeBtModal('viewMaterialModal')">Close</button>
  </div>
</div>

<div id="editMaterialModal" class="bt-modal">
  <div class="bt-modal-content">
    <span class="bt-close" onclick="closeBtModal('editMaterialModal')">&times;</span>
    <h2>Edit Material</h2>
    <p>Update material details in your inventory.</p>
    <form id="editMaterialForm" action="/vendor/update-material" method="post">
      <input type="hidden" name="mat_id" id="editId">
      <div class="form-group">
        <label>Material Name</label>
        <input type="text" name="matName" id="editName" required>
      </div>
      <div class="form-group">
        <label>Category</label>
        <select name="matCategory" id="editCategory" required>
          <option value="Cement & Concrete">Cement & Concrete</option>
          <option value="Steel & Metal">Steel & Metal</option>
          <option value="Bricks & Blocks">Bricks & Blocks</option>
          <option value="Wood & Timber">Wood & Timber</option>
          <option value="Plumbing">Plumbing</option>
          <option value="Electrical">Electrical</option>
          <option value="Other">Other</option>
        </select>
      </div>
      <div class="form-group">
        <label>Stock Quantity</label>
        <input type="number" name="matQuantity" id="editQuantity" min="1" required>
      </div>
      <div class="form-group">
        <label>Price / Unit (₹)</label>
        <input type="number" name="matPrice" id="editPrice" min="1" required>
      </div>
      <button type="submit" class="btn-primary full-width">Update Material</button>
    </form>
  </div>
</div>

<div id="deleteMaterialModal" class="bt-modal">
  <div class="bt-modal-content">
    <span class="bt-close" onclick="closeBtModal('deleteMaterialModal')">&times;</span>
    <h2>Delete Material</h2>
    <p>Are you sure you want to delete this material?</p>
    <p class="delete-name" id="deleteName">-</p>
    <p style="margin-bottom: 1.5rem;">This action cannot be undone.</p>
    <form id="deleteMaterialForm" action="/vendor/delete-material" method="post">
      <input type="hidden" name="mat_id" id="deleteId">
      <button type="submit" class="btn-primary full-width" style="background: linear-gradient(135deg,#ef4444,#dc2626); box-shadow:0 4px 14px rgba(239,68,68,.35);">Yes, Delete</button>
    </form>
  </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
<script src="/js/app.js"></script>
<script>
  function openBtModal(id) {
    document.getElementById(id).style.display = 'flex';
  }
  function closeBtModal(id) {
    document.getElementById(id).style.display = 'none';
  }
  window.onclick = function (event) {
    if (event.target.classList.contains('bt-modal')) {
      event.target.style.display = 'none';
    }
  };

  document.addEventListener('DOMContentLoaded', function () {
    if (window.lucide) lucide.createIcons();

    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
      new bootstrap.Tooltip(el);
    });

    document.getElementById('inventoryLoading').classList.add('show');

    $('#inventoryTable').DataTable({
      responsive: true,
      pageLength: 10,
      order: [[0, 'asc']],
      language: {
        emptyTable: 'No materials added yet. Click "Add New Material" to start.',
        search: 'Search:',
        lengthMenu: 'Show _MENU_ entries'
      },
      dom: "<'row mb-3'<'col-md-6'B><'col-md-6'f>>" +
           "<'row'<'col-12'tr>>" +
           "<'row mt-3'<'col-md-5'i><'col-md-7'p>>",
      buttons: [
        { extend: 'copy', className: 'btn btn-sm', text: '<i class="bi bi-clipboard"></i> Copy' },
        { extend: 'csv', className: 'btn btn-sm', text: '<i class="bi bi-filetype-csv"></i> CSV' },
        { extend: 'excel', className: 'btn btn-sm', text: '<i class="bi bi-file-earmark-excel"></i> Excel' },
        { extend: 'pdf', className: 'btn btn-sm', text: '<i class="bi bi-file-earmark-pdf"></i> PDF' },
        { extend: 'print', className: 'btn btn-sm', text: '<i class="bi bi-printer"></i> Print' }
      ],
      columnDefs: [{ orderable: false, targets: 6 }],
      initComplete: function () {
        document.getElementById('inventoryLoading').classList.remove('show');
      }
    });

    function getRowData(btn) {
      var tr = btn.closest('tr');
      return {
        id: tr.getAttribute('data-id'),
        name: tr.getAttribute('data-name'),
        category: tr.getAttribute('data-category'),
        quantity: tr.getAttribute('data-quantity'),
        price: tr.getAttribute('data-price')
      };
    }

    document.querySelector('#inventoryTable tbody').addEventListener('click', function (e) {
      var viewBtn = e.target.closest('.btn-view');
      var editBtn = e.target.closest('.btn-edit');
      var deleteBtn = e.target.closest('.btn-delete');

      if (viewBtn) {
        var d = getRowData(viewBtn);
        var stock = Number(d.quantity || 0);
        document.getElementById('viewId').textContent = d.id;
        document.getElementById('viewName').textContent = d.name;
        document.getElementById('viewCategory').textContent = d.category;
        document.getElementById('viewQuantity').textContent = d.quantity + ' units';
        document.getElementById('viewStatus').innerHTML = stock > 50
          ? '<span class="badge rounded-pill badge-stock-ok">In Stock</span>'
          : '<span class="badge rounded-pill badge-stock-low">Low Stock</span>';
        document.getElementById('viewPrice').textContent = '₹' + d.price;
        openBtModal('viewMaterialModal');
      }

      if (editBtn) {
        var d = getRowData(editBtn);
        document.getElementById('editId').value = d.id;
        document.getElementById('editName').value = d.name;
        document.getElementById('editCategory').value = d.category;
        document.getElementById('editQuantity').value = d.quantity;
        document.getElementById('editPrice').value = d.price;
        openBtModal('editMaterialModal');
      }

      if (deleteBtn) {
        var d = getRowData(deleteBtn);
        document.getElementById('deleteId').value = d.id;
        document.getElementById('deleteName').textContent = d.name;
        openBtModal('deleteMaterialModal');
      }
    });

    ['addMaterialForm', 'editMaterialForm', 'deleteMaterialForm'].forEach(function (id) {
      var form = document.getElementById(id);
      if (!form) return;
      form.addEventListener('submit', function () {
        document.getElementById('inventoryLoading').classList.add('show');
      });
    });
  });
</script>
