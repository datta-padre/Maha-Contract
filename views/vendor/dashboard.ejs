<%- include('../partials/header') %>
<div class="background-animation"></div>
    <div class="dashboard-layout vendor-desk">
        <%- include('_sidebar', { active: 'dashboard' }) %>
        <main class="dashboard-content">
            <header class="dashboard-header">
                <div>
                    <h2>Vendor overview</h2>
                    <p class="vendor-page-description">A clear view of your materials, deliveries, and payments.</p>
                </div>
            </header>

            <div class="vendor-shortcut-grid" aria-label="Vendor workspace shortcuts">
                <a class="vendor-shortcut" href="/vendor/inventory">
                    <span class="vendor-shortcut-icon"><i data-lucide="package-check" aria-hidden="true"></i></span>
                    <span class="vendor-shortcut-copy">
                        <strong>Manage inventory</strong>
                        <span>Update materials, prices, and stock levels.</span>
                    </span>
                    <i data-lucide="arrow-up-right" class="vendor-shortcut-arrow" aria-hidden="true"></i>
                </a>
                <a class="vendor-shortcut" href="/vendor/orders">
                    <span class="vendor-shortcut-icon"><i data-lucide="truck" aria-hidden="true"></i></span>
                    <span class="vendor-shortcut-copy">
                        <strong>Track deliveries</strong>
                        <span>Review order and delivery assignments.</span>
                    </span>
                    <i data-lucide="arrow-up-right" class="vendor-shortcut-arrow" aria-hidden="true"></i>
                </a>
                <a class="vendor-shortcut" href="/vendor/payments">
                    <span class="vendor-shortcut-icon"><i data-lucide="wallet" aria-hidden="true"></i></span>
                    <span class="vendor-shortcut-copy">
                        <strong>Review payments</strong>
                        <span>Keep track of order payment activity.</span>
                    </span>
                    <i data-lucide="arrow-up-right" class="vendor-shortcut-arrow" aria-hidden="true"></i>
                </a>
            </div>

            <h3 class="vendor-section-title">Recent incoming orders</h3>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Contractor</th>
                            <th>Material Details</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="5" class="vendor-table-empty">No incoming orders yet. New orders will appear here.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </main>
    </div>
    <script src="/js/app.js"></script>
    <script>lucide.createIcons();</script>
