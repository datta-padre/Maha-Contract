<%- include('../partials/header') %>
<div class="background-animation"></div>
    <div class="dashboard-layout">
        <aside class="sidebar">
            <div class="logo sidebar-logo"><i data-lucide="building-2" class="logo-icon"></i><span class="notranslate"><span>Build</span>Tender</span></div>
            <nav class="sidebar-nav">
                <a href="/vendor/dashboard" class="active"><i data-lucide="layout-dashboard"></i> Overview</a>
                <a href="/vendor/inventory"><i data-lucide="list"></i> My Inventory</a>
                <a href="/vendor/orders"><i data-lucide="truck"></i> Live Orders</a>
                <a href="/vendor/payments"><i data-lucide="wallet"></i> Payments</a>
                <a href="/vendor/profile"><i data-lucide="user"></i> Store Profile</a>
                <a href="/" class="logout"><i data-lucide="log-out"></i> Logout</a>
            </nav>
        </aside>
        <main class="dashboard-content">
            <header class="dashboard-header">
                <div>
                    <h2>Vendor Management Console</h2>
                    <p style="color: var(--text-muted); margin-top: 0.25rem;">Monitor your materials, deliveries, and payments.</p>
                </div>
            </header>

            <div class="dashboard-grid" style="margin-bottom: 2rem;">
                <div class="stat-card">
                    <i data-lucide="package-check" style="color: var(--primary);"></i>
                    <h3>0</h3>
                    <p>Listed Materials</p>
                </div>
                <div class="stat-card">
                    <i data-lucide="truck" style="color: var(--accent);"></i>
                    <h3>0</h3>
                    <p>Live Deliveries</p>
                </div>
                <div class="stat-card">
                    <i data-lucide="indian-rupee" style="color: #22c55e;"></i>
                    <h3>0</h3>
                    <p>Pending COD Collections</p>
                </div>
            </div>

            <h3 style="margin-bottom: 1rem; font-family: 'Outfit'; color: var(--accent);">Recent Incoming Orders</h3>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Contractor</th>
                            <th>Material Details</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </main>
    </div>
    <script src="/js/app.js"></script>
    <script>lucide.createIcons();</script>
