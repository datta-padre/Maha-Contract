            <img src="/images/logo.png" alt="">
            <span class="notranslate"><span>Maha</span> Contract</span>
        </a>
        <button class="vendor-menu-toggle" type="button" aria-controls="vendorNavigation" aria-expanded="false" aria-label="Open navigation menu">
            <i data-lucide="menu" aria-hidden="true"></i>
        </button>
    </div>
    <nav class="sidebar-nav vendor-sidebar-nav" id="vendorNavigation" aria-label="Vendor navigation">
