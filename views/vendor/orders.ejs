<%- include('../partials/header') %>
<div class="background-animation"></div>
    <div class="dashboard-layout vendor-desk">
        <%- include('_sidebar', { active: 'orders' }) %>
        <main class="dashboard-content">
            <header class="dashboard-header">
                <div>
                    <h2>Live orders</h2>
                    <p class="vendor-page-description">Track new orders and delivery assignments for your store.</p>
                </div>
            </header>
            <div class="empty-state vendor-empty-state">
                <i data-lucide="truck" aria-hidden="true"></i>
                <h3>No deliveries assigned</h3>
                <p>When a contractor places an order in your service area, its status and delivery details will appear here.</p>
                <a class="vendor-empty-action" href="/vendor/inventory">
                    <i data-lucide="package" aria-hidden="true"></i> Review your inventory
                </a>
            </div>
        </main>
    </div>
    <script src="/js/app.js"></script>
    <script>lucide.createIcons();</script>
