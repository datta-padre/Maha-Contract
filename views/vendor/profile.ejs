<%- include('../partials/header') %>
<div class="background-animation"></div>
    <div class="dashboard-layout vendor-desk vendor-profile-page">
        <%- include('_sidebar', { active: 'profile' }) %>

        <main class="dashboard-content">
            <header class="dashboard-header">
                <div>
                    <h2>Store Profile Settings</h2>
                    <p class="vendor-page-description">Manage your store details, contact information, and business address.</p>
                </div>
            </header>

            <% if (typeof user !== 'undefined' && user) { %>
            <div class="profile-header">
                <div class="profile-avatar"><i data-lucide="store"></i></div>
                <div>
                    <h3 class="vendor-profile-name"><%= user.username %></h3>
                    <p class="vendor-profile-email"><%= user.email %></p>
                    <span class="status-badge" style="background: rgba(34, 197, 94, 0.1); color: #22c55e; border: 1px solid rgba(34, 197, 94, 0.2);">
                        <i data-lucide="check-circle" style="width:14px; display:inline; vertical-align:middle;"></i>
                        <%= user.role %>
                    </span>
                </div>
            </div>

            <form class="tender-form vendor-profile-form" action="/vendor/update-profile" method="post">
                <h3 class="vendor-form-section-title">Business information</h3>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="vendorStoreName">Store name</label>
                        <input id="vendorStoreName" type="text" name="username" autocomplete="organization" value="<%= user.username %>" required>
                    </div>
                    <div class="form-group">
                        <label for="vendorEmail">Business email</label>
                        <input id="vendorEmail" type="email" name="email" autocomplete="email" value="<%= user.email %>" required>
                    </div>
                </div>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="vendorPhone">Store phone number</label>
                        <input id="vendorPhone" type="tel" name="mobile" autocomplete="tel" value="<%= user.mobile %>" required>
                    </div>
                    <div class="form-group">
                        <label for="vendorUserId">Account ID</label>
                        <input id="vendorUserId" type="text" value="<%= user.user_id %>" readonly>
                    </div>
                </div>

                <h3 class="vendor-form-section-title vendor-location-title">Store location</h3>
                <div class="form-grid vendor-address-grid">
                    <div class="form-group">
                        <label for="vendorAddress">Street address</label>
                        <input id="vendorAddress" type="text" name="address" autocomplete="street-address" value="<%= user.address || '' %>" placeholder="Building, street, or area">
                    </div>
                </div>
                <div class="form-grid vendor-location-grid">
                    <div class="form-group">
                        <label for="vendorTaluka">Taluka</label>
                        <input id="vendorTaluka" type="text" name="taluka" autocomplete="address-level3" value="<%= user.taluka || '' %>" placeholder="e.g. Haveli">
                    </div>
                    <div class="form-group">
                        <label for="vendorDistrict">District</label>
                        <input id="vendorDistrict" type="text" name="district" autocomplete="address-level2" value="<%= user.district || '' %>" placeholder="e.g. Pune">
                    </div>
                    <div class="form-group">
                        <label for="vendorState">State</label>
                        <select id="vendorState" name="state" autocomplete="address-level1">
                            <option value="" <%= !user.state ? 'selected' : '' %>>Select State</option>
                            <option value="Maharashtra" <%= user.state === 'Maharashtra' ? 'selected' : '' %>>Maharashtra</option>
                            <option value="Gujarat" <%= user.state === 'Gujarat' ? 'selected' : '' %>>Gujarat</option>
                            <option value="Karnataka" <%= user.state === 'Karnataka' ? 'selected' : '' %>>Karnataka</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="vendorPincode">Pincode</label>
                        <input id="vendorPincode" type="text" name="pincode" autocomplete="postal-code" inputmode="numeric" value="<%= user.pincode || '' %>" placeholder="e.g. 411001">
                    </div>
                </div>
                <button type="submit" class="btn-primary vendor-profile-submit">
                    <i data-lucide="save" aria-hidden="true"></i> Save store details
                </button>
            </form>

            <h3 class="vendor-form-section-title vendor-account-title">Account information</h3>
            <div class="form-grid vendor-account-grid">
                <div class="vendor-account-card">
                    <p>Member since</p>
                    <p><%= user.created_at ? new Date(user.created_at).toLocaleDateString('en-IN') : 'N/A' %></p>
                </div>
                <div class="vendor-account-card">
                    <p>Account role</p>
                    <p><%= user.role %></p>
                </div>
            </div>
            <% } else { %>
            <div class="empty-state">
                <h3>User not found</h3>
                <p>Please login again to view your profile.</p>
                <a href="/" class="btn-primary" style="margin-top: 1rem; display: inline-block;">Go to Login</a>
            </div>
            <% } %>
        </main>
    </div>
    <script src="/js/app.js"></script>
    <script>lucide.createIcons();</script>
