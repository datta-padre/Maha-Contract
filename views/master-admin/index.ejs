<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/master-admin.css">
<%
    var s = (typeof stats !== 'undefined' && stats) ? stats : {};
    var users = (typeof users !== 'undefined' && Array.isArray(users)) ? users : [];

    function safe(v) {
        return (v === undefined || v === null || v === '') ? '—' : v;
    }
    function fullAddress(u) {
        var parts = [u.address, u.taluka, u.district, u.state, u.pincode].filter(function (p) {
            return p !== undefined && p !== null && String(p).trim() !== '';
        });
        return parts.length ? parts.join(', ') : '—';
    }
%>
<div class="background-animation"></div>
<div class="dashboard-layout ma-simple">
    <%- include('./_sidebar') %>

    <main class="dashboard-content">
        <header class="dashboard-header">
            <div>
                <h2>Master Admin Workspace</h2>
                <p style="color: var(--text-muted); margin-top: 0.35rem;">Platform overview — stats and user directory.</p>
            </div>
        </header>

        <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert-banner alert-error" style="margin-bottom: 1.25rem;">
            <i data-lucide="alert-circle"></i>
            <div><strong>Error</strong><p><%= error %></p></div>
        </div>
        <% } %>

        <div class="ma-row-4">
            <div class="stat-card">
                <i data-lucide="users"></i>
                <h3><%= s.totalUsers || 0 %></h3>
                <p>Total Users</p>
            </div>
            <div class="stat-card">
                <i data-lucide="clock"></i>
                <h3><%= s.kycPending || 0 %></h3>
                <p>KYC Pending</p>
            </div>
            <div class="stat-card">
                <i data-lucide="check-circle" style="color:#22c55e;"></i>
                <h3><%= s.kycApproved || 0 %></h3>
                <p>KYC Approved</p>
            </div>
            <div class="stat-card">
                <i data-lucide="home"></i>
                <h3><%= s.houseowners || 0 %></h3>
                <p>House Owners</p>
            </div>
            <div class="stat-card">
                <i data-lucide="hard-hat"></i>
                <h3><%= s.contractors || 0 %></h3>
                <p>Contractors</p>
            </div>
            <div class="stat-card">
                <i data-lucide="truck"></i>
                <h3><%= s.vendors || 0 %></h3>
                <p>Vendors</p>
            </div>
            <div class="stat-card">
                <i data-lucide="package"></i>
                <h3><%= s.materials || 0 %></h3>
                <p>Materials</p>
            </div>
            <div class="stat-card">
                <i data-lucide="file-text"></i>
                <h3><%= s.tenders || 0 %></h3>
                <p>Total Tenders</p>
            </div>
        </div>

        <section class="ma-col-panel ma-users-panel">
            <div class="ma-col-head">
                <div>
                    <h3>Users</h3>
                    <span><%= users.length %> records</span>
                </div>
                <div class="ma-export-bar">
                    <button type="button" class="ma-export-btn" id="btnCopy" title="Copy table">
                        <i data-lucide="copy"></i> Copy
                    </button>
                    <button type="button" class="ma-export-btn" id="btnExcel" title="Download Excel CSV">
                        <i data-lucide="file-spreadsheet"></i> Excel
                    </button>
                    <button type="button" class="ma-export-btn" id="btnPdf" title="Save / print as PDF">
                        <i data-lucide="file-text"></i> PDF
                    </button>
                    <button type="button" class="ma-export-btn" id="btnPrint" title="Print">
                        <i data-lucide="printer"></i> Print
                    </button>
                </div>
            </div>

            <div class="ma-users-toolbar">
                <input type="search" id="userSearch" class="ma-table-search" placeholder="Search name, email, mobile, role…">
            </div>

            <% if (users.length === 0) { %>
            <p class="ma-col-empty">No users found.</p>
            <% } else { %>
            <div class="ma-col-table-wrap" id="usersTableWrap">
                <table class="ma-col-table" id="usersTable">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Mobile</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Address</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(function (u) {
                            var addr = fullAddress(u);
                            var created = u.created_at ? new Date(u.created_at).toLocaleString('en-IN') : '—';
                            var hay = [u.username, u.email, u.mobile, u.role, addr].join(' ').toLowerCase();
                        %>
                        <tr data-search="<%= hay %>">
                            <td><strong><%= safe(u.username) %></strong></td>
                            <td><%= safe(u.mobile) %></td>
                            <td><%= safe(u.email) %></td>
                            <td><span class="ma-role-pill"><%= safe(u.role) %></span></td>
                            <td class="ma-addr-cell"><%= addr %></td>
                            <td><%= created %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% } %>
        </section>
    </main>
</div>

<script src="/js/app.js"></script>
<script>
    if (window.lucide) lucide.createIcons();

    (function () {
        var table = document.getElementById('usersTable');
        var search = document.getElementById('userSearch');
        var toastTimer;

        function showToast(msg) {
            var el = document.getElementById('maExportToast');
            if (!el) {
                el = document.createElement('div');
                el.id = 'maExportToast';
                el.className = 'ma-export-toast';
                document.body.appendChild(el);
            }
            el.textContent = msg;
            el.classList.add('show');
            clearTimeout(toastTimer);
            toastTimer = setTimeout(function () { el.classList.remove('show'); }, 1800);
        }

        function visibleRows() {
            if (!table) return [];
            return Array.prototype.slice.call(table.querySelectorAll('tbody tr')).filter(function (tr) {
                return tr.style.display !== 'none';
            });
        }

        function tableMatrix() {
            var headers = ['Name', 'Mobile', 'Email', 'Role', 'Address', 'Created'];
            var rows = visibleRows().map(function (tr) {
                return Array.prototype.slice.call(tr.cells).map(function (td) {
                    return (td.innerText || '').replace(/\s+/g, ' ').trim();
                });
            });
            return [headers].concat(rows);
        }

        function toCsv(matrix) {
            return matrix.map(function (row) {
                return row.map(function (cell) {
                    var v = String(cell == null ? '' : cell);
                    if (/[",\n]/.test(v)) v = '"' + v.replace(/"/g, '""') + '"';
                    return v;
                }).join(',');
            }).join('\n');
        }

        if (search && table) {
            search.addEventListener('input', function () {
                var q = (search.value || '').trim().toLowerCase();
                table.querySelectorAll('tbody tr').forEach(function (tr) {
                    var hay = tr.getAttribute('data-search') || '';
                    tr.style.display = !q || hay.indexOf(q) !== -1 ? '' : 'none';
                });
            });
        }

        var btnCopy = document.getElementById('btnCopy');
        if (btnCopy) {
            btnCopy.addEventListener('click', async function () {
                var matrix = tableMatrix();
                var text = matrix.map(function (r) { return r.join('\t'); }).join('\n');
                try {
                    await navigator.clipboard.writeText(text);
                    showToast('Table copied');
                } catch (e) {
                    showToast('Copy failed');
                }
            });
        }

        var btnExcel = document.getElementById('btnExcel');
        if (btnExcel) {
            btnExcel.addEventListener('click', function () {
                var csv = '\uFEFF' + toCsv(tableMatrix());
                var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
                var url = URL.createObjectURL(blob);
                var a = document.createElement('a');
                a.href = url;
                a.download = 'buildtender-users.csv';
                a.click();
                URL.revokeObjectURL(url);
                showToast('Excel CSV downloaded');
            });
        }

        function openPrintView(forPdf) {
            var matrix = tableMatrix();
            var html = '<!DOCTYPE html><html><head><title>BuildTender Users</title>';
            html += '<style>body{font-family:Arial,sans-serif;padding:24px;color:#111}';
            html += 'h1{font-size:18px;margin:0 0 4px}p{color:#555;margin:0 0 16px;font-size:13px}';
            html += 'table{width:100%;border-collapse:collapse;font-size:12px}';
            html += 'th,td{border:1px solid #ccc;padding:8px;text-align:left;vertical-align:top}';
            html += 'th{background:#f3f4f6}</style></head><body>';
            html += '<h1>BuildTender — Users</h1>';
            html += '<p>' + (forPdf ? 'Save as PDF from the print dialog.' : 'Print preview') + ' · ' + new Date().toLocaleString('en-IN') + '</p>';
            html += '<table><thead><tr>';
            matrix[0].forEach(function (h) { html += '<th>' + h + '</th>'; });
            html += '</tr></thead><tbody>';
            matrix.slice(1).forEach(function (row) {
                html += '<tr>';
                row.forEach(function (c) { html += '<td>' + String(c).replace(/</g, '&lt;') + '</td>'; });
                html += '</tr>';
            });
            html += '</tbody></table></body></html>';

            var w = window.open('', '_blank', 'width=1000,height=700');
            if (!w) {
                showToast('Pop-up blocked');
                return;
            }
            w.document.write(html);
            w.document.close();
            w.focus();
            setTimeout(function () { w.print(); }, 300);
        }

        var btnPrint = document.getElementById('btnPrint');
        if (btnPrint) btnPrint.addEventListener('click', function () { openPrintView(false); });

        var btnPdf = document.getElementById('btnPdf');
        if (btnPdf) {
            btnPdf.addEventListener('click', function () {
                openPrintView(true);
                showToast('Use Print → Save as PDF');
            });
        }
    })();
</script>
