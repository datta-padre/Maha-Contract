<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/master-admin.css">
<%
    var member = (typeof member !== 'undefined' && member) ? member : {};
    var roleKey = member.roleKey || 'VerifyAdmin';
    var status = String(member.status || 'active').toLowerCase();
%>
<div class="background-animation"></div>
<div class="dashboard-layout ma-simple">
    <%- include('./_sidebar') %>

    <main class="dashboard-content sm-page">
        <header class="dashboard-header sm-header">
            <div>
                <p class="sm-eyebrow">Staff Management</p>
                <h2>Edit Employee</h2>
                <p style="color: var(--text-muted); margin-top: 0.35rem;">Update desk details or reactivate access.</p>
            </div>
            <a href="/master-admin/staff-management/employee-list" class="btn-primary sm-hire-top" style="text-decoration:none;">
                <i data-lucide="arrow-left" style="width:16px;height:16px;"></i>
                Back to list
            </a>
        </header>

        <% if (typeof error !== 'undefined' && error === 'missing') { %>
        <div class="alert-banner alert-error" style="margin-bottom:1rem;">
            <i data-lucide="alert-circle"></i>
            <div><strong>Could not save</strong><p>Please fill all required fields.</p></div>
        </div>
        <% } else if (typeof error !== 'undefined' && error === 'password') { %>
        <div class="alert-banner alert-error" style="margin-bottom:1rem;">
            <i data-lucide="alert-circle"></i>
            <div><strong>Password mismatch</strong><p>New password and confirm password must match.</p></div>
        </div>
        <% } else if (typeof error !== 'undefined' && error === 'passwordweak') { %>
        <div class="alert-banner alert-error" style="margin-bottom:1rem;">
            <i data-lucide="alert-circle"></i>
            <div><strong>Password too short</strong><p>Use at least 4 characters for the new passcode.</p></div>
        </div>
        <% } else if (typeof notice !== 'undefined' && notice === 'password') { %>
        <div class="alert-banner" style="margin-bottom:1rem;border-color:rgba(34,197,94,0.35);background:rgba(34,197,94,0.08);">
            <i data-lucide="key-round"></i>
            <div><strong>Password updated</strong><p>New passcode has been saved for this employee.</p></div>
        </div>
        <% } %>

        <section class="sm-card" style="max-width:100%;">
            <div class="sm-card-head">
                <div>
                    <h3><i data-lucide="user-cog"></i> <%= member.name || 'Employee' %></h3>
                    <p>Joined <%= member.created || '—' %></p>
                </div>
            </div>

            <form class="sm-form" method="post" action="/master-admin/staff-management/employee-list/edit/<%= member.id %>">
                <div class="sm-form-row">
                    <label>
                        <span>Full name</span>
                        <input type="text" name="staffName" value="<%= member.name || '' %>" required>
                    </label>
                    <label>
                        <span>Email</span>
                        <input type="email" name="staffEmail" value="<%= member.email || '' %>" required>
                    </label>
                </div>
                <div class="sm-form-row">
                    <label>
                        <span>Mobile</span>
                        <input type="tel" name="staffMobile" value="<%= member.mobile || '' %>" maxlength="15">
                    </label>
                    <label>
                        <span>Desk role</span>
                        <select name="staffRole" required>
                            <option value="VerifyAdmin" <%= roleKey === 'VerifyAdmin' ? 'selected' : '' %>>Verify Admin</option>
                            <option value="BudgetAdmin" <%= roleKey === 'BudgetAdmin' ? 'selected' : '' %>>Budget Admin</option>
                            <option value="TenderAdmin" <%= roleKey === 'TenderAdmin' ? 'selected' : '' %>>Tender Admin</option>
                            <option value="MaterialsAdmin" <%= roleKey === 'MaterialsAdmin' ? 'selected' : '' %>>Materials Admin</option>
                        </select>
                    </label>
                </div>
                <div class="sm-form-row">
                    <label>
                        <span>Status</span>
                        <select name="staffStatus" required>
                            <option value="active" <%= status === 'active' ? 'selected' : '' %>>Active</option>
                            <option value="inactive" <%= status === 'inactive' ? 'selected' : '' %>>Inactive</option>
                        </select>
                    </label>
                </div>

                <div class="sm-card-head" style="margin-top:0.5rem;padding-top:1rem;">
                    <div>
                        <h3><i data-lucide="key-round"></i> Change password</h3>
                        <p>Leave new fields blank to keep the current passcode.</p>
                    </div>
                </div>

                <div class="sm-form-row">
                    <label>
                        <span>Current password</span>
                        <div class="sm-password-field">
                            <input type="text" id="currentPassword" value="<%= member.hasPassword ? '••••••••' : '' %>" readonly placeholder="No passcode set">
                            <button type="button" class="sm-btn sm-btn-ghost" id="copyPasswordBtn" title="Copy passcode">Copy</button>
                        </div>
                    </label>
                </div>

                <div class="sm-form-row">
                    <label>
                        <span>New password</span>
                        <input type="text" id="staffPassword" name="staffPassword" placeholder="Enter new passcode" autocomplete="new-password">
                    </label>
                    <label>
                        <span>Confirm password</span>
                        <input type="text" id="staffPasswordConfirm" name="staffPasswordConfirm" placeholder="Re-enter new passcode" autocomplete="new-password">
                    </label>
                </div>
                <div class="sm-form-actions" style="justify-content:flex-start;margin-top:0;">
                    <button type="button" class="sm-btn sm-btn-ghost" id="generatePasscodeBtn">
                        <i data-lucide="sparkles" style="width:14px;height:14px;"></i>
                        Generate passcode
                    </button>
                </div>

                <div class="sm-form-actions">
                    <p class="sm-hint"><i data-lucide="info"></i> Profile and password are saved together.</p>
                    <button type="submit" class="btn-primary sm-submit">
                        <i data-lucide="save" style="width:16px;height:16px;"></i>
                        Save changes
                    </button>
                </div>
            </form>
        </section>
    </main>
</div>

<script src="/js/app.js"></script>
<script>
    if (window.lucide) lucide.createIcons();

    (function () {
        var btn = document.getElementById('generatePasscodeBtn');
        var pass = document.getElementById('staffPassword');
        var confirm = document.getElementById('staffPasswordConfirm');
        if (!btn || !pass || !confirm) return;

        btn.addEventListener('click', function () {
            var code = String(Math.floor(100000 + Math.random() * 900000));
            pass.value = code;
            confirm.value = code;
        });

        var copyBtn = document.getElementById('copyPasswordBtn');
        var current = document.getElementById('currentPassword');
        if (copyBtn && current) {
            copyBtn.addEventListener('click', function () {
                if (!current.value) return;
                navigator.clipboard.writeText(current.value).then(function () {
                    copyBtn.textContent = 'Copied';
                    setTimeout(function () { copyBtn.textContent = 'Copy'; }, 1500);
                });
            });
        }
    })();
</script>
