<%- include('../partials/header') %>
<%
    var tender = (typeof tender !== 'undefined' && tender) ? tender : {};
    function safe(val) {
        return (val === undefined || val === null || val === '') ? '—' : val;
    }
    function money(amount) {
        if (amount === undefined || amount === null || amount === '') return '—';
        var n = Number(amount);
        if (isNaN(n)) return '₹' + amount;
        return '₹' + n.toLocaleString('en-IN');
    }
    function docLink(file, label) {
        var name = (file === undefined || file === null) ? '' : String(file).trim();
        if (!name || name === '—') {
            return '<span class="a4-doc a4-doc-off"><i data-lucide="file-x"></i> ' + label + '</span>';
        }
        return '<a class="a4-doc" href="/tenders/' + encodeURIComponent(name) + '" target="_blank" rel="noopener"><i data-lucide="file-text"></i> ' + label + '</a>';
    }
    function row(label, value) {
        return '<tr><th>' + label + '</th><td>' + safe(value) + '</td></tr>';
    }
    var submitted = tender.created_at ? new Date(tender.created_at).toLocaleString('en-IN') : '—';
    var targetDate = tender.estimated_completion_date
        ? new Date(tender.estimated_completion_date).toLocaleDateString('en-IN')
        : '—';
    var budgetStatus = String(tender.budget_status || 'pending').toLowerCase();
    var statusLabel = budgetStatus === 'approved' ? 'Approved' : (budgetStatus === 'estimated' ? 'Estimated' : 'Pending');
%>
<div class="background-animation"></div>
<div class="dashboard-layout">
    <%- include('./_sidebar', { activePage: 'pending' }) %>

    <main class="dashboard-content a4-desk">
        <header class="dashboard-header a4-desk-head">
            <div>
                <h2>Tender A4 Brief</h2>
                <p style="color:var(--text-muted);margin-top:0.35rem;">Official publish-review document for Tender #<%= safe(tender.tender_id) %></p>
            </div>
            <div class="a4-toolbar">
                <a href="/tender-admin/pending" class="a4-tool-btn">
                    <i data-lucide="arrow-left"></i> Back
                </a>
                <button type="button" class="a4-tool-btn" onclick="window.print()">
                    <i data-lucide="printer"></i> Print A4
                </button>
                <% if (tender.tender_id) { %>
                <form method="post" action="/tender-admin/publish/<%= tender.tender_id %>" style="margin:0;">
                    <button type="submit" class="a4-tool-btn a4-tool-btn-approve" onclick="return confirm('Approve and publish this tender to the live marketplace?');">
                        <i data-lucide="badge-check"></i> Approve
                    </button>
                </form>
                <% } %>
            </div>
        </header>

        <div class="a4-stage">
            <article class="a4-sheet" id="a4Sheet">
                <header class="a4-sheet-head">
                    <div class="a4-brand">
                        <div class="a4-logo"><i data-lucide="file-badge"></i></div>
                        <div>
                            <p class="a4-brand-kicker">BuildTender · Tender Admin</p>
                            <h1>Tender Submission Brief</h1>
                        </div>
                    </div>
                    <div class="a4-meta">
                        <div class="a4-meta-box">
                            <span>Tender ID</span>
                            <strong>#<%= safe(tender.tender_id) %></strong>
                        </div>
                        <div class="a4-meta-box">
                            <span>Status</span>
                            <strong class="a4-status a4-status-<%= budgetStatus %>"><%= statusLabel %></strong>
                        </div>
                        <div class="a4-meta-box">
                            <span>Generated</span>
                            <strong><%= new Date().toLocaleString('en-IN') %></strong>
                        </div>
                    </div>
                </header>

                <section class="a4-block">
                    <h2><i data-lucide="user"></i> House Owner</h2>
                    <table class="a4-table">
                        <tbody>
                            <%- row('Owner name', tender.owner_name) %>
                            <%- row('Email', tender.owner_email) %>
                            <%- row('Mobile', tender.owner_mobile) %>
                            <%- row('Submitted on', submitted) %>
                        </tbody>
                    </table>
                </section>

                <section class="a4-block">
                    <h2><i data-lucide="building-2"></i> Project Overview</h2>
                    <table class="a4-table">
                        <tbody>
                            <%- row('Construction code', tender.constructionCode) %>
                            <%- row('Plot area', tender.plotArea) %>
                            <%- row('Plot location', tender.plotLocation) %>
                            <%- row('Soil type', tender.soilType) %>
                            <%- row('BHK', tender.bhk) %>
                            <%- row('Floors', tender.floors) %>
                            <%- row('Construction time', tender.constructionTime) %>
                            <%- row('Materials provided', tender.materialsProvided) %>
                            <%- row('Finalized plan', tender.finalizedPlan) %>
                            <%- row('Ancillary requirements', tender.ancillary_requirements) %>
                            <%- row('External works', tender.externalWorks) %>
                            <%- row('Boundary wall type', tender.boundaryWallType) %>
                        </tbody>
                    </table>
                </section>

                <section class="a4-block">
                    <h2><i data-lucide="indian-rupee"></i> Budget Summary</h2>
                    <div class="a4-budget-grid">
                        <div class="a4-budget-card">
                            <span>Owner budget</span>
                            <strong><%= money(tender.budget) %></strong>
                        </div>
                        <div class="a4-budget-card is-highlight">
                            <span>Estimated cost</span>
                            <strong><%= money(tender.estimated_cost) %></strong>
                        </div>
                        <div class="a4-budget-card">
                            <span>Target completion</span>
                            <strong><%= targetDate %></strong>
                        </div>
                        <div class="a4-budget-card">
                            <span>Platform fee</span>
                            <strong><%= money(tender.payment_amount) %></strong>
                        </div>
                    </div>
                    <% if (tender.budget_notes) { %>
                    <div class="a4-notes">
                        <span>Budget notes</span>
                        <p><%= safe(tender.budget_notes) %></p>
                    </div>
                    <% } %>
                </section>

                <% if (tender.specialInstructions) { %>
                <section class="a4-block">
                    <h2><i data-lucide="message-square"></i> Special Instructions</h2>
                    <div class="a4-notes is-plain">
                        <p><%= safe(tender.specialInstructions) %></p>
                    </div>
                </section>
                <% } %>

                <footer class="a4-sheet-foot">
                    <div>
                        <span>Payment status</span>
                        <strong><%= safe(tender.payment_status) %></strong>
                    </div>
                    <div class="a4-foot-sign">
                        <span>Tender Admin desk</span>
                        <div class="a4-sign-line"></div>
                        <small>Authorized review copy</small>
                    </div>
                    <div class="a4-foot-id">Ref · BT-<%= safe(tender.tender_id) %> · <%= new Date().getFullYear() %></div>
                </footer>
            </article>
        </div>
    </main>
</div>

<style>
.a4-desk { padding-bottom: 2rem; }

.a4-desk-head {
    align-items: flex-start;
    gap: 1rem;
}

.a4-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
}

.a4-tool-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 40px;
    padding: 0 1rem;
    border-radius: 10px;
    border: 1px solid var(--surface-border);
    background: rgba(255,255,255,0.04);
    color: #e2e8f0;
    text-decoration: none;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
}

.a4-tool-btn:last-child {
    background: #a855f7;
    border-color: #a855f7;
    color: #fff;
}

.a4-tool-btn-approve {
    background: #22c55e !important;
    border-color: #22c55e !important;
    color: #fff !important;
}

.a4-tool-btn-approve:hover {
    filter: brightness(1.06);
}

.a4-tool-btn i { width: 16px; height: 16px; }

.a4-stage {
    display: flex;
    justify-content: center;
    padding: 0.5rem 0 1rem;
}

.a4-sheet {
    width: 100%;
    max-width: 794px;
    min-height: 1123px;
    background: #fff;
    color: #0f172a;
    border-radius: 4px;
    box-shadow:
        0 0 0 1px rgba(148,163,184,0.35),
        0 18px 50px rgba(0,0,0,0.35);
    padding: 42px 46px 36px;
    font-family: 'Segoe UI', Arial, sans-serif;
    position: relative;
}

.a4-sheet::before {
    content: '';
    position: absolute;
    inset: 18px;
    border: 1px solid rgba(168,85,247,0.18);
    pointer-events: none;
}

.a4-sheet-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-bottom: 1.1rem;
    margin-bottom: 1.1rem;
    border-bottom: 2px solid #a855f7;
}

.a4-brand {
    display: flex;
    align-items: center;
    gap: 0.85rem;
}

.a4-logo {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #a855f7, #7c3aed);
    color: #fff;
}

.a4-logo i { width: 24px; height: 24px; }

.a4-brand-kicker {
    margin: 0 0 0.2rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #7c3aed;
}

.a4-sheet-head h1 {
    margin: 0;
    font-family: 'Outfit', 'Segoe UI', sans-serif;
    font-size: 1.45rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.2;
}

.a4-meta {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    min-width: 170px;
}

.a4-meta-box {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.45rem 0.65rem;
    border-radius: 8px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    font-size: 0.78rem;
}

.a4-meta-box span { color: #64748b; }
.a4-meta-box strong { color: #0f172a; text-align: right; }

.a4-status-approved { color: #15803d !important; }
.a4-status-estimated { color: #0369a1 !important; }
.a4-status-pending { color: #a16207 !important; }

.a4-block {
    margin-bottom: 1.15rem;
    page-break-inside: avoid;
}

.a4-block h2 {
    margin: 0 0 0.65rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #7c3aed;
    font-weight: 700;
}

.a4-block h2 i { width: 15px; height: 15px; }

.a4-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.86rem;
}

.a4-table th,
.a4-table td {
    border: 1px solid #e2e8f0;
    padding: 0.55rem 0.7rem;
    text-align: left;
    vertical-align: top;
}

.a4-table th {
    width: 34%;
    background: #f8fafc;
    color: #475569;
    font-weight: 600;
    font-size: 0.78rem;
}

.a4-table td {
    color: #0f172a;
    word-break: break-word;
}

.a4-budget-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.65rem;
}

.a4-budget-card {
    padding: 0.75rem 0.85rem;
    border-radius: 10px;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
}

.a4-budget-card span {
    display: block;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #64748b;
    margin-bottom: 0.25rem;
}

.a4-budget-card strong {
    font-size: 1rem;
    color: #0f172a;
}

.a4-budget-card.is-highlight {
    border-color: rgba(168,85,247,0.35);
    background: rgba(168,85,247,0.08);
}

.a4-budget-card.is-highlight strong { color: #7c3aed; }

.a4-notes {
    margin-top: 0.75rem;
    padding: 0.75rem 0.85rem;
    border-radius: 10px;
    border: 1px dashed #cbd5e1;
    background: #fff;
}

.a4-notes.is-plain { margin-top: 0; }

.a4-notes span {
    display: block;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #64748b;
    margin-bottom: 0.35rem;
}

.a4-notes p {
    margin: 0;
    color: #334155;
    font-size: 0.88rem;
    line-height: 1.55;
}

.a4-docs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
}

.a4-doc {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    height: 34px;
    padding: 0 0.75rem;
    border-radius: 8px;
    border: 1px solid #c4b5fd;
    background: #f5f3ff;
    color: #6d28d9;
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 600;
}

.a4-doc i { width: 14px; height: 14px; }

.a4-doc.is-report {
    border-color: #7dd3fc;
    background: #f0f9ff;
    color: #0369a1;
}

.a4-doc.is-map {
    border-color: #86efac;
    background: #f0fdf4;
    color: #15803d;
}

.a4-doc-off {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
}

.a4-sheet-foot {
    margin-top: 1.4rem;
    padding-top: 1rem;
    border-top: 1px solid #e2e8f0;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0.75rem;
    align-items: end;
    font-size: 0.78rem;
    color: #64748b;
}

.a4-sheet-foot span {
    display: block;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.2rem;
}

.a4-sheet-foot strong { color: #0f172a; }

.a4-foot-sign { text-align: center; }

.a4-sign-line {
    width: 140px;
    height: 1px;
    background: #cbd5e1;
    margin: 0.35rem auto 0.25rem;
}

.a4-foot-id {
    text-align: right;
    font-size: 0.72rem;
    color: #94a3b8;
}

@media print {
    @page {
        size: A4;
        margin: 0;
    }
    
    body * { visibility: hidden; }
    .a4-sheet, .a4-sheet * { visibility: visible; }
    .a4-sheet {
        position: absolute;
        left: 0;
        top: 0;
        width: 210mm;
        height: 297mm;
        max-width: none;
        box-shadow: none;
        border-radius: 0;
        padding: 10mm 12mm;
        overflow: hidden;
        transform: scale(0.93);
        transform-origin: top left;
    }
    .a4-sheet::before { display: none; }
    .background-animation,
    .sidebar,
    .a4-desk-head,
    .dashboard-header,
    .a4-toolbar form { display: none !important; }
    .dashboard-content { padding: 0 !important; margin: 0 !important; }
    .dashboard-layout { display: block !important; }
    .a4-stage { padding: 0; }

    .a4-block { margin-bottom: 0.85rem; }
    .a4-table th, .a4-table td { padding: 0.45rem 0.55rem; }
    .a4-budget-card { padding: 0.6rem 0.7rem; }
    .a4-sheet-foot { margin-top: 0.85rem; padding-top: 0.65rem; }
}

@media (max-width: 860px) {
    .a4-sheet { padding: 28px 22px 24px; min-height: auto; }
    .a4-budget-grid { grid-template-columns: 1fr; }
    .a4-sheet-foot { grid-template-columns: 1fr; text-align: left; }
    .a4-foot-id { text-align: left; }
}
</style>

<script src="/js/app.js"></script>
<script>if (window.lucide) lucide.createIcons();</script>
