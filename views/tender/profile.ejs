<%- include('../partials/header') %>
<div class="background-animation"></div>
<div class="dashboard-layout">
    <%- include('./_sidebar', { activePage: 'profile' }) %>

    <main class="dashboard-content">
        <header class="dashboard-header">
            <div>
                <h2>Tender Admin Profile</h2>
                <p style="color: var(--text-muted); margin-top: 0.35rem;">Your desk account for publishing and assigning tenders.</p>
            </div>
        </header>

        <section class="ta-profile">
            <div class="ta-profile-top">
                <div class="ta-avatar">
                    <i data-lucide="file-badge"></i>
                </div>
                <div>
                    <h3>Tender Admin</h3>
                    <p>Publish desk role</p>
                </div>
            </div>

            <div class="ta-profile-grid">
                <div class="ta-profile-card">
                    <span>Desk focus</span>
                    <strong>Marketplace publish & assign</strong>
                </div>
                <div class="ta-profile-card">
                    <span>Primary queue</span>
                    <strong>Pending approved budgets</strong>
                </div>
                <div class="ta-profile-card">
                    <span>Access</span>
                    <strong>Tender Admin panel</strong>
                </div>
            </div>

            <p class="ta-profile-copy">
                Use the sidebar to review pending tenders, publish them live for contractors, and track assigned contracts after award.
            </p>

            <div class="ta-profile-actions">
                <a href="/tender-admin/pending" class="tp-btn tp-btn-primary">
                    <i data-lucide="clock"></i> Go to pending
                </a>
                <a href="/tender-admin" class="tp-btn">
                    <i data-lucide="layout-dashboard"></i> Overview
                </a>
            </div>
        </section>
    </main>
</div>

<style>
.ta-profile {
    max-width: 640px;
    background: rgba(15,23,42,0.6);
    border: 1px solid var(--surface-border);
    border-radius: 18px;
    padding: 1.6rem;
}
.ta-profile-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.35rem;
}
.ta-avatar {
    width: 64px;
    height: 64px;
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(168,85,247,0.15);
    border: 1px solid rgba(168,85,247,0.3);
    color: #c084fc;
}
.ta-avatar i { width: 30px; height: 30px; }
.ta-profile-top h3 {
    margin: 0 0 0.25rem;
    font-family: 'Outfit', sans-serif;
    font-size: 1.25rem;
    color: #fff;
}
.ta-profile-top p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
}
.ta-profile-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.15rem;
}
.ta-profile-card {
    padding: 0.9rem 1rem;
    border-radius: 12px;
    border: 1px solid var(--surface-border);
    background: rgba(0,0,0,0.18);
}
.ta-profile-card span {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.35rem;
}
.ta-profile-card strong {
    font-size: 0.9rem;
    color: #e2e8f0;
}
.ta-profile-copy {
    margin: 0 0 1.25rem;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.65;
}
.ta-profile-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
}
.tp-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    height: 38px;
    padding: 0 0.95rem;
    border-radius: 10px;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid var(--surface-border);
    background: rgba(255,255,255,0.04);
    color: #e2e8f0;
}
.tp-btn i { width: 15px; height: 15px; }
.tp-btn-primary {
    background: #a855f7;
    border-color: #a855f7;
    color: #fff;
}
</style>

<script src="/js/app.js"></script>
<script>if (window.lucide) lucide.createIcons();</script>
