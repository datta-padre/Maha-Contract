<%- include('../partials/header') %>
<div class="login-box">
        <h2><i data-lucide="shield-alert" style="color: #ef4444;"></i> Admin Security</h2>
        <p style="color: var(--text-muted); margin-bottom: 2rem;">Authorized BuildTender Staff Only.</p>
        
        <form onsubmit="event.preventDefault(); submitAdmin();">
            <div class="form-group mt-4">
                <label>Admin Email Address</label>
                <input type="email" id="adminEmail" placeholder="super@buildtender.com" required>
            </div>
            <div class="form-group mt-4">
                <label>Master Passcode</label>
                <input type="password" id="adminPass" placeholder="••••••••" required>
            </div>
            <button type="submit" class="btn-primary full-width mt-4" style="background: #ef4444;">Authenticate Access To Directory</button>
            <a href="/" style="display: block; text-align: center; margin-top: 1.5rem; color: var(--text-muted); text-decoration: none; font-size: 0.9rem;">Return to Public Entry</a>
        </form>
    </div>

    <script src="/js/app.js"></script>
    <script>lucide.createIcons();</script>
