    <script src="/js/app.js"></script>
    <script>
        lucide.createIcons();

        // Custom Layout Styling exclusively for the Tab Interface and Partitions
        const style = document.createElement('style');
        style.innerHTML = `
            .tab-btn { background: transparent; color: var(--text-muted); border: none; padding: 0.5rem 1rem; border-radius: 6px; cursor: pointer; transition: 0.2s; font-weight: bold; }
            .tab-btn.active { background: var(--primary); color: #fff; }
            .tab-btn:hover:not(.active) { background: rgba(255,255,255,0.05); }
            .partition-btn { background: rgba(0,0,0,0.4); border: 1px solid var(--surface-border); color: var(--text-muted); padding: 0.5rem 1rem; border-radius: 20px; cursor: pointer; transition: 0.2s; }
            .partition-btn.active { border-color: var(--primary); color: #fff; background: rgba(var(--primary-rgb), 0.1); }
        `;
        document.head.appendChild(style);

        // Core Functions
        function switchTab(tabId, btn) {
            document.querySelectorAll('.tab-content').forEach(el => el.style.display = 'none');
            document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
            document.getElementById(tabId).style.display = 'block';
            btn.classList.add('active');
        }

        // Feature: Global Live Partition Filtering
        function filterPartition(roleType) {
            // Update active state of buttons
            const btns = document.getElementById('partitionButtons').children;
            for(let btn of btns) {
                if(btn.innerText.includes(roleType)) {
                    btn.classList.add('active');
                } else if(roleType === 'All' && btn.innerText === 'All') {
                    btn.classList.add('active');
                } else {
                    btn.classList.remove('active');
                }
            }

            // Filter Matrix Rows
            const rows = document.querySelectorAll('.dir-row');
            rows.forEach(row => {
                if(roleType === 'All') {
                    row.style.display = '';
                } else {
                    if(row.getAttribute('data-role') === roleType) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                }
            });
        }

        // Live Fetch from Backend Database
        document.addEventListener('DOMContentLoaded', async () => {
            try {
                const res = await fetch('http://localhost:3000/api/admin/system-stats');
                const data = await res.json();
                
                if (data.success) {
                    // Injecting DB variables into the frontend
                    // Let's assume ₹10,000 avg revenue per user proxy and ₹24,00,000 avg tender proxy
                    document.getElementById('db-revenue').innerText = '₹' + (data.stats.users * 12775 + data.stats.tenders * 5999).toLocaleString();
                    document.getElementById('db-tender-value').innerText = '₹' + (data.stats.tenders * 2400000).toLocaleString();
                }
            } catch(e) {
                console.log("DB Stats Fetch Error. Server might be offline. Loading cached static metrics.", e);
            }
        });

        // Live Search implementation natively on directory
        document.getElementById('superSearchInput').addEventListener('input', function(e) {
            let term = e.target.value.toLowerCase();
            const rows = document.querySelectorAll('.dir-row');
            rows.forEach(row => {
                if(row.innerText.toLowerCase().includes(term)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });
    </script>
