<%- include('../partials/header') %>
<div class="background-animation" style="background-image: linear-gradient(rgba(15,23,42,0.85), rgba(15,23,42,0.85)), url('hero-bg.png'); background-size: cover; background-position: center;"></div>
    
    <div class="dashboard-layout">
        <aside class="sidebar">
            <div class="logo sidebar-logo">
                <i data-lucide="hard-hat" class="logo-icon"></i>
                <span class="notranslate"><span>Build</span>Tender</span>
            </div>
            <nav class="sidebar-nav">
                <a href="/houseowner/overview"><i data-lucide="layout-dashboard"></i> Overview Dashboard</a>
                <a href="/houseowner/post"><i data-lucide="file-plus"></i> Post Tender Details</a>
                <a href="/houseowner/tenders" class="active"><i data-lucide="file-text"></i> Active Tenders</a>
                <a href="/houseowner/materials"><i data-lucide="shopping-bag"></i> Material Shop</a>
                <a href="/houseowner/payments"><i data-lucide="wallet"></i> Payment & Receipts</a>
                <a href="/houseowner/profile"><i data-lucide="user"></i> My Profile</a>
                <a href="/logout" class="logout"><i data-lucide="log-out"></i> Logout</a>
            </nav>
        </aside>

        <main class="dashboard-content">
            <header class="dashboard-header">
                <div>
                    <h2>My Active Tenders</h2>
                    <p style="color: var(--text-muted); margin-top: 0.25rem;">Monitor projects safely uploaded by the System Admins on your behalf.</p>
                </div>
                <div class="user-profile">
                    <span class="status-badge" style="background: rgba(34, 197, 94, 0.1); color: #22c55e; border: 1px solid rgba(34, 197, 94, 0.2);">Verified Owner</span>
                </div>
            </header>

            <div id="tenderContainer">
                 <table id="tenderTable" class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Tender ID</th>
                            <th>Tender Name</th>
                            <th>Tender Description</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (tenders && tenders.length > 0) { %>
                            <% tenders.forEach(function(t) { %>
                                <tr>
                                    <td><%= t.tender_id %></td>
                                    <td><%= t.plotArea || '-' %></td>
                                    <td>
                                        <%= (t.plotLocation || '').toString().slice(0, 60) || '-' %>
                                        <%= t.plotLocation && String(t.plotLocation).length > 60 ? '...' : '' %>
                                    </td>
                                    <td>
                                        <% if (t.payment_status === 'paid') { %>
                                            <span style="color:#22c55e; font-weight:700;">Paid</span>
                                        <% } else if (t.payment_status === 'failed') { %>
                                            <span style="color:#ef4444; font-weight:700;">Failed</span>
                                        <% } else { %>
                                            <span style="color: #f97316; font-weight:700;">Pending</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" style="text-align:center; color: var(--text-muted);">
                                    No tenders found.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                 </table>
            </div>

        </main>
    </div>
    <script src="/js/app.js"></script>
