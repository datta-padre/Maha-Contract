<%
    var page = (typeof activePage !== 'undefined') ? activePage : 'overview';
%>
<aside class="sidebar ho-sidebar">
    <div class="ho-topbar">
        <a href="/houseowner/overview" class="ho-topbar-brand">
            <img class="ho-topbar-icon" src="/images/logo.png" alt="Maha Contract">
            <span class="ho-topbar-title notranslate"><em>Maha</em> Contract</span>
        </a>
        <button type="button" class="ho-menu-btn" aria-label="Toggle navigation" aria-expanded="false">
            <i data-lucide="menu"></i>
        </button>
    </div>
    <nav class="sidebar-nav ho-sidebar-nav">
        <a href="/houseowner/overview" class="<%= page === 'overview' ? 'active' : '' %>">
            <i data-lucide="layout-dashboard"></i> Overview
        </a>
        <a href="/houseowner/post" class="<%= page === 'post' ? 'active' : '' %>">
            <i data-lucide="file-plus"></i> Post Tender
        </a>
        <a href="/houseowner/tenders" class="<%= page === 'tenders' ? 'active' : '' %>">
            <i data-lucide="file-text"></i> Active Tenders
        </a>
        <a href="/houseowner/materials" class="<%= page === 'materials' ? 'active' : '' %>">
            <i data-lucide="shopping-bag"></i> Material Shop
        </a>
        <a href="/houseowner/payments" class="<%= page === 'payments' ? 'active' : '' %>">
            <i data-lucide="wallet"></i> Payments
        </a>
        <a href="/houseowner/profile" class="<%= page === 'profile' ? 'active' : '' %>">
            <i data-lucide="user"></i> My Profile
        </a>
        <a href="/logout" class="logout"><i data-lucide="log-out"></i> Logout</a>
    </nav>
</aside>
<script>
document.addEventListener('DOMContentLoaded', function () {
    var root = document.querySelector('.ho-desk');
    if (!root) return;

    var btn = root.querySelector('.ho-menu-btn');
    var nav = root.querySelector('.ho-sidebar-nav');
    if (!btn || !nav) return;

    function setMenuOpen(open) {
        nav.classList.toggle('menu-open', open);
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        btn.innerHTML = open ? '<i data-lucide="x"></i>' : '<i data-lucide="menu"></i>';
        if (window.lucide) lucide.createIcons();
    }

    btn.addEventListener('click', function (e) {
        setMenuOpen(!nav.classList.contains('menu-open'));
        e.stopPropagation();
    });

    document.addEventListener('click', function (e) {
        if (!nav.classList.contains('menu-open')) return;
        if (!nav.contains(e.target) && !btn.contains(e.target)) setMenuOpen(false);
    });

    window.addEventListener('resize', function () {
        if (window.innerWidth > 1024 && nav.classList.contains('menu-open')) setMenuOpen(false);
    });
});
</script>
