<%- include('../partials/header') %>
<div class="background-animation"></div>
<div class="dashboard-layout ho-desk">
    <%- include('./_sidebar', { activePage: 'profile' }) %>

    <main class="dashboard-content">
        <header class="dashboard-header ho-header">
            <div>
                <p class="ho-kicker">House Owner</p>
                <h2>Account Settings</h2>
                <p class="ho-subtitle">Manage your personal profile, contact details, and security.</p>
            </div>
        </header>

        <% if (typeof user !== 'undefined' && user) { %>
        <section class="ho-profile-card">
            <div class="ho-profile-avatar"><i data-lucide="user"></i></div>
            <div class="ho-profile-meta">
                <h3><%= user.username %></h3>
                <p><%= user.email %></p>
                <span class="ho-role-badge">
                    <i data-lucide="shield-check"></i>
                    <%= user.role %>
                </span>
            </div>
        </section>

        <form class="ho-profile-form" action="/update-profile" method="post">
            <div class="ho-form-section">
                <h3>Personal information</h3>
                <div class="ho-form-grid">
                    <div class="form-group">
                        <label for="hoUsername">Full Name</label>
                        <input id="hoUsername" type="text" name="username" value="<%= user.username %>" required>
                    </div>
                    <div class="form-group">
                        <label for="hoEmail">Email Address</label>
                        <input id="hoEmail" type="email" name="email" value="<%= user.email %>" required>
                    </div>
                    <div class="form-group">
                        <label for="hoMobile">Phone Number</label>
                        <input id="hoMobile" type="tel" name="mobile" value="<%= user.mobile %>" required>
                    </div>
                    <div class="form-group">
                        <label for="hoPassword">Change Password</label>
                        <input id="hoPassword" type="password" name="password" placeholder="Leave blank to keep current password">
                    </div>
                </div>
            </div>

            <div class="ho-form-section">
                <h3>Location details</h3>
                <div class="ho-form-grid">
                    <div class="form-group ho-form-span">
                        <label for="hoAddress">Street Address</label>
                        <input id="hoAddress" type="text" name="address" value="<%= user.address || '' %>" placeholder="Flat, House no., Building, Company, Apartment">
                    </div>
                    <div class="form-group">
                        <label for="hoTaluka">Taluka (Tal)</label>
                        <input id="hoTaluka" type="text" name="taluka" value="<%= user.taluka || '' %>" placeholder="e.g. Haveli">
                    </div>
                    <div class="form-group">
                        <label for="hoDistrict">District (Dist)</label>
                        <input id="hoDistrict" type="text" name="district" value="<%= user.district || '' %>" placeholder="e.g. Pune">
                    </div>
                    <div class="form-group">
                        <label for="hoState">State</label>
                        <select id="hoState" name="state">
                            <option value="" <%= !user.state ? 'selected' : '' %>>Select State</option>
                            <option value="Maharashtra" <%= user.state === 'Maharashtra' ? 'selected' : '' %>>Maharashtra</option>
                            <option value="Gujarat" <%= user.state === 'Gujarat' ? 'selected' : '' %>>Gujarat</option>
                            <option value="Karnataka" <%= user.state === 'Karnataka' ? 'selected' : '' %>>Karnataka</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="hoPincode">Pincode</label>
                        <input id="hoPincode" type="text" name="pincode" value="<%= user.pincode || '' %>" placeholder="e.g. 411001">
                    </div>
                </div>
            </div>

            <div class="ho-form-actions">
                <button type="submit" class="btn-primary">
                    <i data-lucide="save"></i> Save Changes
                </button>
            </div>
        </form>

        <section class="ho-form-section">
            <h3>Account info</h3>
            <div class="ho-info-grid">
                <div class="ho-info-card">
                    <p class="ho-info-label">Member Since</p>
                    <p class="ho-info-value"><%= user.created_at ? new Date(user.created_at).toLocaleDateString('en-IN') : 'N/A' %></p>
                </div>
                <div class="ho-info-card">
                    <p class="ho-info-label">Account Role</p>
                    <p class="ho-info-value"><%= user.role %></p>
                </div>
            </div>
        </section>
        <% } else { %>
        <section class="ho-empty-panel">
            <div class="ho-empty-icon">
                <i data-lucide="user-x"></i>
            </div>
            <h3>User not found</h3>
            <p>Please login again to view your profile.</p>
            <div class="ho-empty-actions">
                <a href="/" class="btn-primary">Go to Login</a>
            </div>
        </section>
        <% } %>
    </main>
</div>
<script src="/js/app.js"></script>
<script>lucide.createIcons();</script>
