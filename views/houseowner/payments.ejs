<%- include('../partials/header') %>
<div class="background-animation"></div>
<div class="dashboard-layout ho-desk">
    <%- include('./_sidebar', { activePage: 'payments' }) %>

    <main class="dashboard-content">
        <header class="dashboard-header ho-header">
            <div>
                <p class="ho-kicker">House Owner</p>
                <h2>Payments & Receipts</h2>
                <p class="ho-subtitle">Track milestone payouts sent to your contractor through the platform.</p>
            </div>
            <a href="/houseowner/tenders" class="btn-secondary ho-header-cta">
                <i data-lucide="file-text"></i> View tenders
            </a>
        </header>

        <section class="ho-empty-panel">
            <div class="ho-empty-icon">
                <i data-lucide="receipt"></i>
            </div>
            <h3>No transactions yet</h3>
            <p>You have not made any phase-based payments to a contractor yet. Payments will appear here once milestones are completed.</p>
            <div class="ho-empty-actions">
                <a href="/houseowner/post" class="btn-primary">
                    <i data-lucide="file-plus"></i> Post a tender
                </a>
                <a href="/houseowner/overview" class="btn-secondary">Back to overview</a>
            </div>
        </section>
    </main>
</div>
<script src="/js/app.js"></script>
<script>lucide.createIcons();</script>
