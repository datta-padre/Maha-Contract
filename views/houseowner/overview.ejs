<%- include('../partials/header') %>
<div class="background-animation"></div>
    <div class="dashboard-layout">
        <aside class="sidebar">
            <div class="logo sidebar-logo"><i data-lucide="hard-hat" class="logo-icon"></i><span class="notranslate"><span>Build</span>Tender</span></div>
            <nav class="sidebar-nav">
                <a href="/houseowner/overview" class="active"><i data-lucide="layout-dashboard"></i> Overview Dashboard</a>
                <a href="/houseowner/post"><i data-lucide="file-plus"></i> Post Tender Details</a>
                <a href="/houseowner/tenders"><i data-lucide="file-text"></i> Active Tenders</a>
                <a href="/houseowner/materials"><i data-lucide="shopping-bag"></i> Material Shop</a>
                <a href="/houseowner/payments"><i data-lucide="wallet"></i> Payment & Receipts</a>
                <a href="/houseowner/profile"><i data-lucide="user"></i> My Profile</a>
                <a href="/logout" class="logout"><i data-lucide="log-out"></i> Logout</a>
            </nav>
        </aside>

        <main class="dashboard-content">
            <header class="dashboard-header">
                <div>
                    <h2>Account Overview</h2>
                    <p style="color: var(--text-muted);">Top-level metrics regarding your construction projects.</p>
                </div>
            </header>

            <div class="dashboard-grid" style="margin-bottom: 2rem;">
                <a href="/houseowner/tenders">
                <div class="stat-card">
                    <i data-lucide="folder" style="color: #38bdf8;"></i>
                    <h3 style="font-size: 2rem; font-weight: 600; color: var(--accent);text-decoration: none;"><%= total_tenders %></h3>
                    <p style="color: var(--text-muted);">Total Tenders Posted</p>
                </div>
                </a>
                <a href="/houseowner/tenders">
                <div class="stat-card">
                    <i data-lucide="hard-hat" style="color: #22c55e;"></i>
                    <h3>0</h3>
                    <p>Contractors Hired</p>
                </div>
                <a href="/houseowner/payments">
                    <div class="stat-card">
                        <i data-lucide="wallet" style="color: #a855f7;"></i>
                        <h3>0</h3>
                        <p>Total Capital Disbursed</p>
                    </div>
                </a>
            </div>

            <div class="empty-state">
                <i data-lucide="activity" style="width: 48px; height: 48px; margin-bottom: 1rem; color: var(--surface-border);"></i>
                <h3>No Account Activity</h3>
                <p>You have not posted any property blueprints yet. Go to 'Post Tender Details' to begin your first project.</p>
            </div>
        </main>
    </div>
    <script src="/js/app.js"></script>
    <script>lucide.createIcons();</script>
