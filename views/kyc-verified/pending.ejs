<%- include('../partials/header') %>
<%
    var pending = (typeof pendingUsers !== 'undefined' && Array.isArray(pendingUsers)) ? pendingUsers : [];

    function safe(val) {
        return (val === undefined || val === null || val === '') ? '—' : val;
    }
    function money(amount) {
        if (!amount && amount !== 0) return '—';
        return '₹' + Number(amount).toLocaleString('en-IN');
    }
    function payBadge(status) {
        var s = (status || 'pending').toLowerCase();
        if (s === 'paid') return { color: '#22c55e', bg: 'rgba(34,197,94,0.12)', label: 'Paid' };
        if (s === 'failed') return { color: '#ef4444', bg: 'rgba(239,68,68,0.12)', label: 'Failed' };
        return { color: '#eab308', bg: 'rgba(234,179,8,0.12)', label: 'Unpaid' };
    }
    function docUrl(file) {
        if (!file || !String(file).trim()) return '';
        return '/verify-admin/view-doc?file=' + encodeURIComponent(String(file).trim());
    }
    function kycDocs(u) {
        return [
            { label: 'Photo', icon: 'camera', file: u.profile_picture },
            { label: 'Signature', icon: 'pen-line', file: u.digital_signature },
            { label: 'Qualification', icon: 'graduation-cap', file: u.qualifications },
            { label: 'License', icon: 'badge-check', file: u.licenses },
            { label: 'Aadhaar', icon: 'id-card', file: u.adhar_card },
            { label: 'PAN', icon: 'credit-card', file: u.pan_card },
            { label: 'GST', icon: 'receipt', file: u.gst_certificate },
            { label: 'Income cert', icon: 'file-badge', file: u.insurance_certificate },
            { label: 'NCL', icon: 'shield', file: u.non_crime_certificate },
            { label: 'Police NOC', icon: 'shield-alert', file: u.police_ncertificate },
            { label: 'Portfolio', icon: 'briefcase', file: u.previous_work },
            { label: 'Stamp', icon: 'stamp', file: u.legal_agreement }
        ].map(function (d) {
            d.uploaded = !!(d.file && String(d.file).trim());
            return d;
        });
    }
    function uploadedCount(docs) {
        var n = 0;
        for (var i = 0; i < docs.length; i++) if (docs[i].uploaded) n++;
        return n;
    }
%>
<div class="background-animation"></div>
<div class="dashboard-layout kyc-desk">
    <%- include('./_sidebar') %>

    <main class="dashboard-content">
        <header class="dashboard-header kyc-queue-header">
            <div>
                <p class="kyc-kicker">Verify Admin</p>
                <h2>Pending KYC Queue</h2>
                <p class="kyc-subtitle">Review contractor documents, then approve or reject each submission.</p>
            </div>
            <div class="kyc-queue-count">
                <i data-lucide="inbox"></i>
                <div>
                    <span>In queue</span>
                    <strong><%= pending.length %></strong>
                </div>
            </div>
        </header>

        <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert-banner alert-error" style="margin-bottom: 1.25rem;">
            <i data-lucide="alert-circle"></i>
            <div><strong>Error</strong><p><%= error %></p></div>
        </div>
        <% } %>

        <div class="kyc-toolbar">
            <div class="kyc-search">
                <i data-lucide="search"></i>
                <input type="search" id="searchInput" placeholder="Search name, email, phone or KYC ID">
            </div>
            <div class="kyc-toolbar-links">
                <a href="/verify-admin" class="kyc-ghost-link">
                    <i data-lucide="layout-dashboard"></i> Overview
                </a>
                <a href="/verify-admin/verified" class="kyc-ghost-link">
                    <i data-lucide="database"></i> Verified
                </a>
            </div>
        </div>

        <% if (pending.length === 0) { %>
        <section class="kyc-empty-panel">
            <div class="kyc-empty-icon">
                <i data-lucide="check-circle-2"></i>
            </div>
            <h3>Queue is clear</h3>
            <p>No contractors are waiting for document validation. New KYC submissions will appear here automatically.</p>
            <div class="kyc-empty-actions">
                <a href="/verify-admin" class="btn-secondary">Back to overview</a>
                <a href="/verify-admin/verified" class="btn-primary">Open verified database</a>
            </div>
        </section>
        <% } else { %>
        <p class="kyc-list-hint" id="queueHint"><%= pending.length %> contractor<%= pending.length === 1 ? '' : 's' %> waiting for review</p>
        <div class="kyc-queue-list">
            <% pending.forEach(function (u) {
                var pay = payBadge(u.payment_status);
                var docs = kycDocs(u);
                var uploaded = uploadedCount(docs);
                var searchKey = [u.kyc_id, u.full_name, u.email, u.phone, u.specialization].join(' ').toLowerCase();
            %>
            <article class="kyc-card kyc-search-item" data-search="<%= searchKey %>">
                <button type="button" class="kyc-card-head" onclick="toggleDetails(<%= u.kyc_id %>)">
                    <div class="kyc-card-identity">
                        <span class="kyc-avatar"><%= String(safe(u.full_name)).charAt(0).toUpperCase() %></span>
                        <div>
                            <h3>
                                <%= safe(u.full_name) %>
                                <span class="kyc-pill kyc-pill-warn">KYC #<%= u.kyc_id %></span>
                                <span class="kyc-pill" style="color:<%= pay.color %>;background:<%= pay.bg %>;"><%= pay.label %></span>
                            </h3>
                            <p><%= safe(u.email) %> · <%= safe(u.phone) %> · <%= safe(u.specialization) %></p>
                        </div>
                    </div>
                    <div class="kyc-card-meta">
                        <span><%= uploaded %>/<%= docs.length %> docs</span>
                        <i data-lucide="chevron-down" id="icon-<%= u.kyc_id %>"></i>
                    </div>
                </button>

                <div class="kyc-card-body" id="details-<%= u.kyc_id %>" hidden>
                    <div class="kyc-meta-grid">
                        <div>
                            <p>Experience</p>
                            <strong><%= safe(u.experience) %> yrs</strong>
                        </div>
                        <div>
                            <p>Availability</p>
                            <strong><%= safe(u.availability) %></strong>
                        </div>
                        <div>
                            <p>Base price</p>
                            <strong><%= u.base_price_range ? ('₹' + u.base_price_range + '/sq.ft') : '—' %></strong>
                        </div>
                        <div>
                            <p>Payment</p>
                            <strong><%= safe(u.contractor_payment_status) %> · <%= money(u.payment_amount) %></strong>
                        </div>
                        <div>
                            <p>Submitted</p>
                            <strong><%= u.created_at ? new Date(u.created_at).toLocaleString('en-IN') : '—' %></strong>
                        </div>
                    </div>

                    <div class="kyc-docs-block">
                        <div class="kyc-docs-head">
                            <p>KYC documents</p>
                            <span><%= uploaded %> / <%= docs.length %> uploaded</span>
                        </div>
                        <div class="kyc-doc-grid">
                            <% docs.forEach(function (doc) { %>
                                <% if (doc.uploaded) { %>
                                <a class="kyc-doc-card is-uploaded" href="<%= docUrl(doc.file) %>" target="_blank" rel="noopener">
                                    <i data-lucide="<%= doc.icon %>"></i>
                                    <strong><%= doc.label %></strong>
                                    <em>View file</em>
                                </a>
                                <% } else { %>
                                <div class="kyc-doc-card is-missing">
                                    <i data-lucide="<%= doc.icon %>"></i>
                                    <strong><%= doc.label %></strong>
                                    <em>Not uploaded</em>
                                </div>
                                <% } %>
                            <% }) %>
                        </div>
                    </div>

                    <div class="kyc-card-actions">
                        <button type="button" class="btn-primary kyc-approve" onclick="setKycStatus(<%= u.kyc_id %>, 'approve')">
                            <i data-lucide="check-circle"></i> Approve
                        </button>
                        <button type="button" class="btn-secondary kyc-reject" onclick="setKycStatus(<%= u.kyc_id %>, 'reject')">
                            <i data-lucide="x-circle"></i> Reject
                        </button>
                    </div>
                </div>
            </article>
            <% }) %>
        </div>
        <% } %>
    </main>
</div>

<script src="/js/app.js"></script>
<script>
    if (window.lucide) lucide.createIcons();

    var searchInput = document.getElementById('searchInput');
    if (searchInput) {
        searchInput.addEventListener('input', function (e) {
            var term = e.target.value.toLowerCase();
            var visible = 0;
            document.querySelectorAll('.kyc-card').forEach(function (card) {
                var hay = (card.getAttribute('data-search') || '').toLowerCase();
                var show = hay.indexOf(term) !== -1;
                card.style.display = show ? '' : 'none';
                if (show) visible += 1;
            });
            var hint = document.getElementById('queueHint');
            if (hint) hint.textContent = visible + ' contractor' + (visible === 1 ? '' : 's') + ' waiting for review';
        });
    }

    function toggleDetails(id) {
        var el = document.getElementById('details-' + id);
        var icon = document.getElementById('icon-' + id);
        if (!el) return;
        el.hidden = !el.hidden;
        if (icon) icon.setAttribute('data-lucide', el.hidden ? 'chevron-down' : 'chevron-up');
        if (window.lucide) lucide.createIcons();
    }

    async function setKycStatus(id, action) {
        var label = action === 'approve' ? 'Approve' : 'Reject';
        if (!confirm(label + ' KYC #' + id + '?')) return;
        try {
            var res = await fetch('/verify-admin/' + action + '/' + id, { method: 'POST' });
            var data = await res.json();
            if (!data.success) {
                alert(data.message || 'Action failed.');
                return;
            }
            window.location.reload();
        } catch (err) {
            console.error(err);
            alert('Action failed.');
        }
    }
</script>
