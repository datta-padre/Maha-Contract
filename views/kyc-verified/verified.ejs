<%- include('../partials/header') %>
<%
    var approved = (typeof approvedUsers !== 'undefined' && Array.isArray(approvedUsers)) ? approvedUsers : [];

    function safe(val) {
        return (val === undefined || val === null || val === '') ? '—' : val;
    }
    function money(amount) {
        if (!amount && amount !== 0) return '—';
        return '₹' + Number(amount).toLocaleString('en-IN');
    }
    function payBadge(status) {
        var s = (status || 'pending').toLowerCase();
        if (s === 'paid') return { cls: 'is-ok', label: 'Paid' };
        if (s === 'failed') return { cls: 'is-bad', label: 'Failed' };
        return { cls: 'is-warn', label: 'Unpaid' };
    }
    function docUrl(file) {
        if (!file || !String(file).trim()) return '';
        return '/verify-admin/view-doc?file=' + encodeURIComponent(String(file).trim());
    }
    function kycDocs(u) {
        return [
            { label: 'Photo', file: u.profile_picture },
            { label: 'Signature', file: u.digital_signature },
            { label: 'Qualification', file: u.qualifications },
            { label: 'License', file: u.licenses },
            { label: 'Aadhaar', file: u.adhar_card },
            { label: 'PAN', file: u.pan_card },
            { label: 'GST', file: u.gst_certificate },
            { label: 'Income cert', file: u.insurance_certificate },
            { label: 'NCL', file: u.non_crime_certificate },
            { label: 'Police NOC', file: u.police_ncertificate },
            { label: 'Portfolio', file: u.previous_work },
            { label: 'Stamp', file: u.legal_agreement }
        ].map(function (d) {
            d.uploaded = !!(d.file && String(d.file).trim());
            return d;
        });
    }
    function uploadedCount(docs) {
        var n = 0;
        for (var i = 0; i < docs.length; i++) if (docs[i].uploaded) n++;
        return n;
    }
%>
<div class="background-animation"></div>
<div class="dashboard-layout kyc-desk">
    <%- include('./_sidebar') %>

    <main class="dashboard-content">
        <header class="dashboard-header kyc-queue-header">
            <div>
                <p class="kyc-kicker">Verify Admin</p>
                <h2>Verified Contractors</h2>
                <p class="kyc-subtitle">Approved KYC records with documents and payment status.</p>
            </div>
            <div class="kyc-queue-count">
                <i data-lucide="badge-check"></i>
                <div>
                    <span>Verified</span>
                    <strong><%= approved.length %></strong>
                </div>
            </div>
        </header>

        <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert-banner alert-error" style="margin-bottom: 1.25rem;">
            <i data-lucide="alert-circle"></i>
            <div><strong>Error</strong><p><%= error %></p></div>
        </div>
        <% } %>

        <div class="kyc-toolbar">
            <div class="kyc-search">
                <i data-lucide="search"></i>
                <input type="search" id="searchInput" placeholder="Search name, email, phone or KYC ID">
            </div>
            <div class="kyc-toolbar-links">
                <a href="/verify-admin" class="kyc-ghost-link">
                    <i data-lucide="layout-dashboard"></i> Overview
                </a>
                <a href="/verify-admin/pending" class="kyc-ghost-link">
                    <i data-lucide="clock"></i> Pending queue
                </a>
            </div>
        </div>

        <% if (approved.length === 0) { %>
        <section class="kyc-empty-panel">
            <div class="kyc-empty-icon muted">
                <i data-lucide="database"></i>
            </div>
            <h3>No verified contractors yet</h3>
            <p>Approved KYC records will appear here after you clear the pending queue.</p>
            <div class="kyc-empty-actions">
                <a href="/verify-admin/pending" class="btn-primary">Open pending queue</a>
            </div>
        </section>
        <% } else { %>
        <p class="kyc-list-hint" id="verifiedHint"><%= approved.length %> verified contractor<%= approved.length === 1 ? '' : 's' %></p>
        <div class="kyc-verified-mobile" id="verifiedList">
            <% approved.forEach(function (u) {
                var pay = payBadge(u.payment_status);
                var docs = kycDocs(u);
                var uploaded = uploadedCount(docs);
                var searchKey = [u.kyc_id, u.full_name, u.email, u.phone, u.specialization].join(' ').toLowerCase();
            %>
            <article class="kyc-verified-card kyc-search-item" data-search="<%= searchKey %>">
                <div class="kyc-verified-card-head">
                    <strong><%= safe(u.full_name) %></strong>
                    <span class="kyc-id">#<%= u.kyc_id %></span>
                </div>
                <p class="kyc-verified-contact"><%= safe(u.email) %> · <%= safe(u.phone) %></p>
                <p class="kyc-verified-specialty"><%= safe(u.specialization) %> · <%= uploaded %>/<%= docs.length %> docs</p>
                <div class="kyc-verified-meta">
                    <span class="kyc-pill <%= pay.cls %>"><%= pay.label %></span>
                    <span class="kyc-verified-amount"><%= money(u.payment_amount) %></span>
                    <span class="kyc-pill is-ok">Approved</span>
                </div>
                <div class="kyc-doc-chips">
                    <% docs.forEach(function (doc) { %>
                        <% if (doc.uploaded) { %>
                        <a class="kyc-doc-chip is-uploaded" href="<%= docUrl(doc.file) %>" target="_blank" rel="noopener"><%= doc.label %></a>
                        <% } else { %>
                        <span class="kyc-doc-chip is-missing"><%= doc.label %></span>
                        <% } %>
                    <% }) %>
                </div>
            </article>
            <% }) %>
        </div>
        <div class="kyc-table-wrap kyc-table-desktop">
            <table class="kyc-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Contact</th>
                        <th>Specialization</th>
                        <th>Payment</th>
                        <th>Documents</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% approved.forEach(function (u) {
                        var pay = payBadge(u.payment_status);
                        var docs = kycDocs(u);
                        var uploaded = uploadedCount(docs);
                        var searchKey = [u.kyc_id, u.full_name, u.email, u.phone, u.specialization].join(' ').toLowerCase();
                    %>
                    <tr class="verified-row" data-search="<%= searchKey %>">
                        <td>#<%= u.kyc_id %></td>
                        <td>
                            <strong><%= safe(u.full_name) %></strong>
                            <div class="kyc-table-sub"><%= uploaded %>/<%= docs.length %> docs</div>
                        </td>
                        <td>
                            <div><%= safe(u.email) %></div>
                            <div class="kyc-table-sub"><%= safe(u.phone) %></div>
                        </td>
                        <td><%= safe(u.specialization) %></td>
                        <td>
                            <span class="kyc-pill <%= pay.cls %>"><%= pay.label %></span>
                            <div class="kyc-table-sub"><%= money(u.payment_amount) %></div>
                        </td>
                        <td>
                            <div class="kyc-doc-chips">
                                <% docs.forEach(function (doc) { %>
                                    <% if (doc.uploaded) { %>
                                    <a class="kyc-doc-chip is-uploaded" href="<%= docUrl(doc.file) %>" target="_blank" rel="noopener"><%= doc.label %></a>
                                    <% } else { %>
                                    <span class="kyc-doc-chip is-missing"><%= doc.label %></span>
                                    <% } %>
                                <% }) %>
                            </div>
                        </td>
                        <td><span class="kyc-pill is-ok">Approved</span></td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
        <% } %>
    </main>
</div>

<script src="/js/app.js"></script>
<script>
    if (window.lucide) lucide.createIcons();
    var searchInput = document.getElementById('searchInput');
    if (searchInput) {
        searchInput.addEventListener('input', function (e) {
            var term = e.target.value.toLowerCase();
            var visible = 0;
            document.querySelectorAll('.verified-row, .kyc-search-item').forEach(function (row) {
                var hay = (row.getAttribute('data-search') || '').toLowerCase();
                var show = hay.indexOf(term) !== -1;
                row.style.display = show ? '' : 'none';
                if (show) visible += 1;
            });
            var hint = document.getElementById('verifiedHint');
            if (hint) hint.textContent = visible + ' verified contractor' + (visible === 1 ? '' : 's');
        });
    }
</script>
