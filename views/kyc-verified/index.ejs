<%- include('../partials/header') %>
<%
    var pending = (typeof pendingUsers !== 'undefined' && Array.isArray(pendingUsers)) ? pendingUsers : [];
    var approved = (typeof approvedUsers !== 'undefined' && Array.isArray(approvedUsers)) ? approvedUsers : [];

    function safe(val) {
        return (val === undefined || val === null || val === '') ? '—' : val;
    }
    function money(amount) {
        if (!amount && amount !== 0) return '—';
        return '₹' + Number(amount).toLocaleString('en-IN');
    }
    function statusBadge(status) {
        var s = (status || 'pending').toLowerCase();
        if (s === 'approved') return { cls: 'is-ok', label: 'Approved' };
        if (s === 'rejected') return { cls: 'is-bad', label: 'Rejected' };
        return { cls: 'is-warn', label: 'Pending' };
    }
    function payBadge(status) {
        var s = (status || 'pending').toLowerCase();
        if (s === 'paid') return { cls: 'is-ok', label: 'Paid' };
        if (s === 'failed') return { cls: 'is-bad', label: 'Failed' };
        return { cls: 'is-warn', label: 'Unpaid' };
    }
    function docUrl(file) {
        if (!file || !String(file).trim()) return '';
        return '/verify-admin/view-doc?file=' + encodeURIComponent(String(file).trim());
    }
    function kycDocs(u) {
        return [
            { label: 'Photo', icon: 'camera', file: u.profile_picture },
            { label: 'Signature', icon: 'pen-line', file: u.digital_signature },
            { label: 'Qualification', icon: 'graduation-cap', file: u.qualifications },
            { label: 'License', icon: 'badge-check', file: u.licenses },
            { label: 'Aadhaar', icon: 'id-card', file: u.adhar_card },
            { label: 'PAN', icon: 'credit-card', file: u.pan_card },
            { label: 'GST', icon: 'receipt', file: u.gst_certificate },
            { label: 'Income cert', icon: 'file-badge', file: u.insurance_certificate },
            { label: 'NCL', icon: 'shield', file: u.non_crime_certificate },
            { label: 'Police NOC', icon: 'shield-alert', file: u.police_ncertificate },
            { label: 'Portfolio', icon: 'briefcase', file: u.previous_work },
            { label: 'Stamp', icon: 'stamp', file: u.legal_agreement }
        ].map(function (d) {
            d.uploaded = !!(d.file && String(d.file).trim());
            return d;
        });
    }
    function uploadedCount(docs) {
        var n = 0;
        for (var i = 0; i < docs.length; i++) if (docs[i].uploaded) n++;
        return n;
    }
%>
<div class="background-animation"></div>
<div class="dashboard-layout kyc-desk">
    <%- include('./_sidebar') %>

    <main class="dashboard-content">
        <header class="dashboard-header kyc-queue-header">
            <div>
                <p class="kyc-kicker">Verify Admin</p>
                <h2>KYC Workspace</h2>
                <p class="kyc-subtitle">Review contractor submissions, check documents, then approve or reject.</p>
            </div>
            <a href="/verify-admin/pending" class="btn-primary kyc-header-cta">
                <i data-lucide="clock"></i> Open queue
            </a>
        </header>

        <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert-banner alert-error" style="margin-bottom: 1.25rem;">
            <i data-lucide="alert-circle"></i>
            <div><strong>Error</strong><p><%= error %></p></div>
        </div>
        <% } %>

        <div class="kyc-stat-row">
            <div class="kyc-stat-card">
                <i data-lucide="clock"></i>
                <div>
                    <strong><%= pending.length %></strong>
                    <p>Pending</p>
                </div>
            </div>
            <div class="kyc-stat-card is-ok">
                <i data-lucide="check-circle"></i>
                <div>
                    <strong><%= approved.length %></strong>
                    <p>Verified</p>
                </div>
            </div>
            <div class="kyc-stat-card is-bad">
                <i data-lucide="x-circle"></i>
                <div>
                    <strong><%= typeof rejectedCount !== 'undefined' ? rejectedCount : 0 %></strong>
                    <p>Rejected</p>
                </div>
            </div>
        </div>

        <section class="kyc-section">
            <div class="kyc-section-head">
                <h3>Pending contractor KYC</h3>
                <a href="/verify-admin/pending">View all</a>
            </div>

            <% if (pending.length === 0) { %>
            <div class="kyc-empty-panel compact">
                <div class="kyc-empty-icon"><i data-lucide="check-circle-2"></i></div>
                <h3>Queue is clear</h3>
                <p>No contractors are waiting for document validation.</p>
            </div>
            <% } else { %>
            <div class="kyc-queue-list">
                <% pending.forEach(function (u) {
                    var badge = statusBadge(u.contractor_kyc_status);
                    var pay = payBadge(u.payment_status);
                    var docs = kycDocs(u);
                    var uploaded = uploadedCount(docs);
                %>
                <article class="kyc-card kyc-overview-card">
                    <div class="kyc-card-identity">
                        <span class="kyc-avatar"><%= String(safe(u.full_name)).charAt(0).toUpperCase() %></span>
                        <div>
                            <h3>
                                <%= safe(u.full_name) %>
                                <span class="kyc-pill <%= badge.cls %>"><%= badge.label %></span>
                                <span class="kyc-pill <%= pay.cls %>"><%= pay.label %></span>
                                <span class="kyc-id">#<%= u.kyc_id %></span>
                            </h3>
                            <p><%= safe(u.email) %> · <%= safe(u.phone) %></p>
                        </div>
                    </div>

                    <div class="kyc-meta-grid">
                        <div><p>Experience</p><strong><%= safe(u.experience) %> yrs</strong></div>
                        <div><p>Specialization</p><strong><%= safe(u.specialization) %></strong></div>
                        <div><p>Availability</p><strong><%= safe(u.availability) %></strong></div>
                        <div><p>Base price</p><strong><%= u.base_price_range ? ('₹' + u.base_price_range + '/sq.ft') : '—' %></strong></div>
                        <div><p>Location</p><strong><%= safe(u.location_link) %></strong></div>
                        <div><p>Submitted</p><strong><%= u.created_at ? new Date(u.created_at).toLocaleString('en-IN') : '—' %></strong></div>
                    </div>

                    <div class="kyc-docs-block">
                        <div class="kyc-docs-head">
                            <p>KYC documents</p>
                            <span><%= uploaded %> / <%= docs.length %> uploaded</span>
                        </div>
                        <div class="kyc-doc-grid">
                            <% docs.forEach(function (doc) { %>
                                <% if (doc.uploaded) { %>
                                <a class="kyc-doc-card is-uploaded" href="<%= docUrl(doc.file) %>" target="_blank" rel="noopener">
                                    <i data-lucide="<%= doc.icon %>"></i>
                                    <strong><%= doc.label %></strong>
                                    <em>View file</em>
                                </a>
                                <% } else { %>
                                <div class="kyc-doc-card is-missing">
                                    <i data-lucide="<%= doc.icon %>"></i>
                                    <strong><%= doc.label %></strong>
                                    <em>Not uploaded</em>
                                </div>
                                <% } %>
                            <% }) %>
                        </div>
                    </div>

                    <p class="kyc-txn">Txn: <%= safe(u.payment_transaction_id) %> · Order: <%= safe(u.razorpay_order_id) %></p>

                    <div class="kyc-card-actions">
                        <button type="button" class="btn-primary kyc-approve" onclick="setKycStatus(<%= u.kyc_id %>, 'approve')">
                            <i data-lucide="check-circle"></i> Approve
                        </button>
                        <button type="button" class="btn-secondary kyc-reject" onclick="setKycStatus(<%= u.kyc_id %>, 'reject')">
                            <i data-lucide="x-circle"></i> Reject
                        </button>
                    </div>
                </article>
                <% }) %>
            </div>
            <% } %>
        </section>

        <section class="kyc-section">
            <div class="kyc-section-head">
                <h3>Recently verified</h3>
                <a href="/verify-admin/verified">Open database</a>
            </div>

            <% if (approved.length === 0) { %>
            <div class="kyc-empty-panel compact">
                <div class="kyc-empty-icon muted"><i data-lucide="database"></i></div>
                <h3>No verified contractors yet</h3>
                <p>Approved KYC records will appear here.</p>
            </div>
            <% } else { %>
            <div class="kyc-verified-mobile">
                <% approved.forEach(function (u) {
                    var pay = payBadge(u.payment_status);
                    var docs = kycDocs(u);
                %>
                <article class="kyc-verified-card">
                    <div class="kyc-verified-card-head">
                        <strong><%= safe(u.full_name) %></strong>
                        <span class="kyc-id">#<%= u.kyc_id %></span>
                    </div>
                    <p class="kyc-verified-contact"><%= safe(u.email) %> · <%= safe(u.phone) %></p>
                    <div class="kyc-verified-meta">
                        <span class="kyc-pill <%= pay.cls %>"><%= pay.label %></span>
                        <span class="kyc-verified-amount"><%= money(u.payment_amount) %></span>
                        <span class="kyc-pill is-ok">Approved</span>
                    </div>
                    <div class="kyc-doc-chips">
                        <% docs.forEach(function (doc) { %>
                            <% if (doc.uploaded) { %>
                            <a class="kyc-doc-chip is-uploaded" href="<%= docUrl(doc.file) %>" target="_blank" rel="noopener"><%= doc.label %></a>
                            <% } else { %>
                            <span class="kyc-doc-chip is-missing"><%= doc.label %></span>
                            <% } %>
                        <% }) %>
                    </div>
                </article>
                <% }) %>
            </div>
            <div class="kyc-table-wrap kyc-table-desktop">
                <table class="kyc-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Payment</th>
                            <th>Documents</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% approved.forEach(function (u) {
                            var pay = payBadge(u.payment_status);
                            var docs = kycDocs(u);
                        %>
                        <tr>
                            <td>#<%= u.kyc_id %></td>
                            <td><strong><%= safe(u.full_name) %></strong></td>
                            <td><%= safe(u.email) %></td>
                            <td><%= safe(u.phone) %></td>
                            <td><span class="kyc-pill <%= pay.cls %>"><%= pay.label %></span> <%= money(u.payment_amount) %></td>
                            <td>
                                <div class="kyc-doc-chips">
                                    <% docs.forEach(function (doc) { %>
                                        <% if (doc.uploaded) { %>
                                        <a class="kyc-doc-chip is-uploaded" href="<%= docUrl(doc.file) %>" target="_blank" rel="noopener"><%= doc.label %></a>
                                        <% } else { %>
                                        <span class="kyc-doc-chip is-missing"><%= doc.label %></span>
                                        <% } %>
                                    <% }) %>
                                </div>
                            </td>
                            <td><span class="kyc-pill is-ok">Approved</span></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% } %>
        </section>
    </main>
</div>

<script src="/js/app.js"></script>
<script>
    if (window.lucide) lucide.createIcons();

    async function setKycStatus(id, action) {
        var label = action === 'approve' ? 'Approve' : 'Reject';
        if (!confirm(label + ' KYC #' + id + '?')) return;
        try {
            var res = await fetch('/verify-admin/' + action + '/' + id, { method: 'POST' });
            var data = await res.json();
            if (!data.success) {
                alert(data.message || 'Action failed.');
                return;
            }
            window.location.reload();
        } catch (err) {
            console.error(err);
            alert('Action failed.');
        }
    }
</script>
